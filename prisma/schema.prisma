model RentalBill {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  unitId         String           @map("unit_id") @db.Uuid
  contractId     String           @map("contract_id") @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  billNo         String           @map("bill_no")
  period         String // YYYY-MM
  issueDate      DateTime         @map("issue_date") @db.Date
  dueDate        DateTime         @map("due_date") @db.Date
  status         RentalBillStatus @default(draft)
  rentAmount     Decimal          @default(0) @map("rent_amount") @db.Decimal(15, 2)
  electricAmount Decimal          @default(0) @map("electric_amount") @db.Decimal(15, 2)
  waterAmount    Decimal          @default(0) @map("water_amount") @db.Decimal(15, 2)
  otherAmount    Decimal          @default(0) @map("other_amount") @db.Decimal(15, 2)
  lateFeeAmount  Decimal          @default(0) @map("late_fee_amount") @db.Decimal(15, 2)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(15, 2)
  subtotal       Decimal          @default(0) @db.Decimal(15, 2)
  vatAmount      Decimal          @default(0) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount    Decimal          @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount     Decimal          @default(0) @map("paid_amount") @db.Decimal(15, 2)
  note           String?
  pdfUrl         String?          @map("pdf_url")
  publicToken    String?          @map("public_token")
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz(6)
  sentChannel    String?          @map("sent_channel")
  reminderSentAt DateTime?        @map("reminder_sent_at") @db.Timestamptz(6)
  autoGenerated  Boolean          @default(false) @map("auto_generated")
  // การยกเลิกบิลแบบขออนุมัติ (maker≠checker) + log
  voidStatus       String         @default("none") @map("void_status") // none | pending | approved | rejected
  voidReason       String?        @map("void_reason")
  voidRequestedBy  String?        @map("void_requested_by") @db.Uuid
  voidRequestedAt  DateTime?      @map("void_requested_at") @db.Timestamptz(6)
  voidDecidedBy    String?        @map("void_decided_by") @db.Uuid
  voidDecidedAt    DateTime?      @map("void_decided_at") @db.Timestamptz(6)
  voidDecisionNote String?        @map("void_decision_note")
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  project   RentalProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit      RentalUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  contract  RentalContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tenant    RentalTenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items     RentalBillItem[]
  payments  RentalPayment[]
  discounts RentalDiscount[]

  @@unique([contractId, period])
  @@unique([orgId, billNo])
  @@unique([publicToken])
  @@index([orgId, projectId, status])
  @@index([orgId, status, dueDate])
  @@map("rental_bill")
  @@schema("public")
}

model RentalBillItem {
