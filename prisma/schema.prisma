  applicantId  String               @map("applicant_id") @db.Uuid
  refId        String               @map("ref_id")
  reason       String?
  status       RecruitErasureStatus @default(PENDING)
  requestedAt  DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt    DateTime?            @map("decided_at") @db.Timestamptz(6)
  decidedById  String?              @map("decided_by_id") @db.Uuid
  decisionNote String?              @map("decision_note")

  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  applicant RecruitApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  decidedBy User?            @relation("RecruitErasureDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([applicantId])
  @@map("recruit_erasure_requests")
  @@schema("public")
}

// =============================================================
// REPAIR MODULE — ระบบแจ้งซ่อม
// 7 tables · ใครก็แจ้งได้ · admin assign + dispatch · tech see own jobs ·
// purchasing sees parts queue · timeline + photos · tracking via code+phone.
// =============================================================

enum RepairTicketStatus {
  NEW
  ACK
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CLOSED
  CANCELLED

  @@schema("public")
}

enum RepairUrgency {
  URGENT
  NORMAL
  LOW

  @@schema("public")
}

enum RepairReportSource {
  GUIDED
  FREEFORM
  INTERNAL

  @@schema("public")
}

enum RepairPhotoPhase {
  BEFORE
  DURING
  AFTER
  PART
  RECEIPT

  @@schema("public")
}

enum RepairTechnicianKind {
  INTERNAL
  VENDOR

  @@schema("public")
}

enum RepairPartStatus {
  NEEDED
  ORDERED
  DELIVERED
  INSTALLED
  CANCELLED

  @@schema("public")
}

enum RepairEventKind {
  CREATED
  STATUS_CHANGE
  ASSIGN
  UNASSIGN
  COMMENT
  PART_ADDED
  PART_UPDATED
  PHOTO_ADDED
  REOPEN
  CLOSE
  ETA_SET

  @@schema("public")
}

model RepairCategory {
  id             String        @id @default(uuid()) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  slug           String
  label          String
  emoji          String?
  defaultUrgency RepairUrgency @default(NORMAL) @map("default_urgency")
  sortOrder      Int           @default(0) @map("sort_order")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tickets RepairTicket[]

  @@unique([orgId, slug])
  @@index([orgId, isActive, sortOrder])
  @@map("repair_categories")
  @@schema("public")
}

model RepairTechnician {
  id          String               @id @default(uuid()) @db.Uuid
  orgId       String               @map("org_id") @db.Uuid
  kind        RepairTechnicianKind
  userId      String?              @unique @map("user_id") @db.Uuid
  name        String
  phone       String?
  lineId      String?              @map("line_id")
  specialties String[]             @default([])
  isActive    Boolean              @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  tickets      RepairTicket[]
  vendorTokens RepairVendorToken[]

  @@index([orgId, kind, isActive])
  @@index([orgId, phone])
  @@map("repair_technicians")
  @@schema("public")
}

model RepairTicket {
  id             String             @id @default(uuid()) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  companyId      String?            @map("company_id") @db.Uuid
  branchId       String?            @map("branch_id") @db.Uuid
  categoryId     String?            @map("category_id") @db.Uuid
  ticketCode     String             @unique @map("ticket_code")
  title          String
  description    String             @default("")
  customerImpact String?            @map("customer_impact")
  status         RepairTicketStatus @default(NEW)
  urgency        RepairUrgency      @default(NORMAL)
  source         RepairReportSource @default(FREEFORM)
  reporterName   String             @map("reporter_name")
  reporterPhone  String             @map("reporter_phone")
  reporterEmail  String?            @map("reporter_email")
  reporterUserId String?            @map("reporter_user_id") @db.Uuid
  assignedTechId String?            @map("assigned_tech_id") @db.Uuid
  assignedAt     DateTime?          @map("assigned_at") @db.Timestamptz(6)
  responseDueAt  DateTime?          @map("response_due_at") @db.Timestamptz(6)
  resolveDueAt   DateTime?          @map("resolve_due_at") @db.Timestamptz(6)
  etaAt          DateTime?          @map("eta_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?          @map("acknowledged_at") @db.Timestamptz(6)
  startedAt      DateTime?          @map("started_at") @db.Timestamptz(6)
  resolvedAt     DateTime?          @map("resolved_at") @db.Timestamptz(6)
  resolvedById   String?            @map("resolved_by_id") @db.Uuid
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz(6)
  closedById     String?            @map("closed_by_id") @db.Uuid
  cancelledAt    DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  partsCostCents Int                @default(0) @map("parts_cost_cents")
  laborCostCents Int                @default(0) @map("labor_cost_cents")
  ipAddress      String?            @map("ip_address")
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  org          Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch       Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category     RepairCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reporterUser User?                 @relation("RepairTicketReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  assignedTech RepairTechnician?     @relation(fields: [assignedTechId], references: [id], onDelete: SetNull)
  resolvedBy   User?                 @relation("RepairTicketResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  closedBy     User?                 @relation("RepairTicketCloser", fields: [closedById], references: [id], onDelete: SetNull)
  photos       RepairPhoto[]
  parts        RepairPart[]
  events       RepairTimelineEvent[]

  @@index([orgId, status, urgency, createdAt(sort: Desc)])
  @@index([orgId, branchId, status])
  @@index([orgId, assignedTechId, status])
  @@index([orgId, categoryId])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([reporterPhone])
  @@map("repair_tickets")
  @@schema("public")
}

model RepairPhoto {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  ticketId       String           @map("ticket_id") @db.Uuid
  phase          RepairPhotoPhase
  r2Key          String           @map("r2_key")
  r2PublicUrl    String           @map("r2_public_url")
  contentType    String           @default("image/webp") @map("content_type")
  sizeBytes      Int              @default(0) @map("size_bytes")
  width          Int?
  height         Int?
  caption        String?
  uploadedById   String?          @map("uploaded_by_id") @db.Uuid
  uploadedByName String?          @map("uploaded_by_name")
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket     RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User?        @relation("RepairPhotoUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId, phase, createdAt])
  @@index([orgId, expiresAt])
  @@map("repair_photos")
  @@schema("public")
}

model RepairPart {
  id             String           @id @default(uuid()) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  ticketId       String           @map("ticket_id") @db.Uuid
  name           String
  spec           String?
  quantity       Int              @default(1)
  unit           String           @default("ชิ้น")
  unitPriceCents Int              @default(0) @map("unit_price_cents")
  status         RepairPartStatus @default(NEEDED)
  supplier       String?
  receiptR2Key   String?          @map("receipt_r2_key")
  notes          String?
  addedById      String           @map("added_by_id") @db.Uuid
  orderedAt      DateTime?        @map("ordered_at") @db.Timestamptz(6)
  orderedById    String?          @map("ordered_by_id") @db.Uuid
  deliveredAt    DateTime?        @map("delivered_at") @db.Timestamptz(6)
  installedAt    DateTime?        @map("installed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  addedBy   User         @relation("RepairPartAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  orderedBy User?        @relation("RepairPartOrderedBy", fields: [orderedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([ticketId])
  @@index([orgId, name])
  @@map("repair_parts")
  @@schema("public")
}

model RepairTimelineEvent {
  id          String          @id @default(uuid()) @db.Uuid
  orgId       String          @map("org_id") @db.Uuid
  ticketId    String          @map("ticket_id") @db.Uuid
  kind        RepairEventKind
  actorUserId String?         @map("actor_user_id") @db.Uuid
  actorName   String          @map("actor_name")
  payload     Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?        @relation("RepairTimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([orgId, createdAt])
  @@map("repair_timeline_events")
  @@schema("public")
}

model RepairVendorToken {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  technicianId String    @map("technician_id") @db.Uuid
  token        String    @unique
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  usageCount   Int       @default(0) @map("usage_count")

  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  technician RepairTechnician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([orgId, technicianId])
  @@index([token])
  @@index([expiresAt])
  @@map("repair_vendor_tokens")
  @@schema("public")
}

// =============================================================
// CLAWFLEET — ระบบบริหารตู้คีบ + ตู้แลกเหรียญ
// Spec: docs/CLAWFLEET_PLAN.md (v2 · 2026-05-21)
// 9 tables · token-exchange group cross-check · multi-branch
// =============================================================

enum CfMachineKind {
  CLAW
  EXCHANGER

  @@schema("public")
}

enum CfEventType {
  INITIAL // กรอกครั้งเดียวตอนตั้งตู้ใหม่
  COLLECTION // รอบเก็บปกติ
  VOID // soft delete event

  @@schema("public")
}

enum CfStockMoveType {
  RECEIVE // รับสินค้าเข้าคลัง
  LOAD_TO_MACHINE // เติมเข้าตู้
  COUNT_SNAPSHOT // นับสต๊อกวันนี้
  ADJUST // ปรับมือ (require approve)

  @@schema("public")
}

enum CfSessionStatus {
  OPEN
  CLOSED
  ANOMALY_REVIEW
  LOCKED

  @@schema("public")
}

enum CfDeliveryStatus {
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  CANCELLED

  @@schema("public")
}

enum CfProductCategory {
  PLUSH // ตุ๊กตา
  TOY // ของเล่น
  UTILITY // ของใช้
  MYSTERY_BOX // กล่องสุ่ม
  MODEL // โมเดล
  KEYCHAIN // พวงกุญแจ
  SNACK // ขนม
  OTHER

  @@schema("public")
}

// =============================================================
// CF.1 — cf_machines (ทุกตู้: CLAW + EXCHANGER)
// =============================================================
model CfMachine {
  id               String        @id @default(uuid()) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  branchId         String        @map("branch_id") @db.Uuid
  groupId          String?       @map("group_id") @db.Uuid
  code             String // "CW-001" หรือ "EX-01"
  nickname         String?
  kind             CfMachineKind
  qrToken          String        @unique @map("qr_token") // สำหรับ scan ก่อนกรอก
  serial           String?
  // mirror (updated via AFTER INSERT trigger on cf_collection_events)
  lastCoinMeter    Int           @default(0) @map("last_coin_meter")
  lastDollMeter    Int           @default(0) @map("last_doll_meter")
  lastDollStock    Int           @default(0) @map("last_doll_stock")
  lastEventAt      DateTime?     @map("last_event_at") @db.Timestamptz(6)
  // initial values (กรอกตอนสร้างตู้ · ใช้ตอน INITIAL event)
  initialCoinMeter Int           @default(0) @map("initial_coin_meter")
  initialDollMeter Int           @default(0) @map("initial_doll_meter")
  installedAt      DateTime?     @map("installed_at") @db.Date
  retiredAt        DateTime?     @map("retired_at") @db.Timestamptz(6)
  isActive         Boolean       @default(true) @map("is_active")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  org               Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  group             CfMachineGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  loadouts          CfMachineLoadout[]
  exchangerLoadouts CfExchangerLoadout[]
  events            CfCollectionEvent[]
  exchangerOfGroup  CfMachineGroup?      @relation("CfGroupExchanger")
  stockMovements    CfStockMovement[]

  @@unique([orgId, code])
  @@index([orgId, branchId, kind, isActive])
  @@index([orgId, groupId])
  @@map("cf_machines")
  @@schema("public")
}

// =============================================================
// CF.2 — cf_machine_groups (1 EX + N CLAW)
// =============================================================
model CfMachineGroup {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String // "โซน A ชุมพวง"
  exchangerId  String?  @unique @map("exchanger_id") @db.Uuid // 1 group = 1 ตู้แลก
  toleranceBps Int      @default(500) @map("tolerance_bps") // 500 = 5%
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch    Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  exchanger CfMachine?            @relation("CfGroupExchanger", fields: [exchangerId], references: [id], onDelete: SetNull)
  machines  CfMachine[]
  sessions  CfCollectionSession[]

  @@index([orgId, branchId, isActive])
  @@map("cf_machine_groups")
  @@schema("public")
}

// =============================================================
// CF.3 — cf_products (สินค้าในตู้)
// =============================================================
model CfProduct {
  id                String            @id @default(uuid()) @db.Uuid
  orgId             String            @map("org_id") @db.Uuid
  sku               String
  name              String
  category          CfProductCategory @default(PLUSH)
  defaultPriceCoins Int               @default(1) @map("default_price_coins") // ค่าเล่นเริ่มต้น (จำนวนเหรียญ/ครั้ง)
  unitCostCents     Int               @default(0) @map("unit_cost_cents") // ราคาทุน
  imageUrl          String?           @map("image_url")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  org            Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  loadouts       CfMachineLoadout[]
  stockMovements CfStockMovement[]

  @@unique([orgId, sku])
  @@index([orgId, category, isActive])
  @@map("cf_products")
  @@schema("public")
}

// =============================================================
// CF.4 — cf_machine_loadouts (CLAW: สินค้า + ราคา/ครั้ง ใน effective period)
// =============================================================
model CfMachineLoadout {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  machineId         String    @map("machine_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  pricePerPlayCoins Int       @default(1) @map("price_per_play_coins") // ค่าเล่น (เหรียญ/ครั้ง · ปกติ 1 เหรียญ = 10฿)
  effectiveFrom     DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz(6)
  setById           String?   @map("set_by_id") @db.Uuid
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  machine CfMachine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  product CfProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orgId, machineId, effectiveTo])
  @@index([orgId, productId])
  @@map("cf_machine_loadouts")
  @@schema("public")
}

// =============================================================
// CF.5 — cf_exchanger_loadouts (EXCHANGER: rate + promo tiers)
// =============================================================
model CfExchangerLoadout {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  machineId       String    @map("machine_id") @db.Uuid
  // base rate: ฿1 → กี่เหรียญ (default 1.0)
  baseCoinPerBaht Decimal   @default(1.0) @map("base_coin_per_baht") @db.Decimal(8, 4)
  // promo tiers JSON [{thb:100, coins:11}, {thb:500, coins:60}]
  promoTiers      Json      @default("[]") @map("promo_tiers")
  effectiveFrom   DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(6)
  setById         String?   @map("set_by_id") @db.Uuid
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  machine CfMachine    @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([orgId, machineId, effectiveTo])
  @@map("cf_exchanger_loadouts")
  @@schema("public")
}

// =============================================================
// CF.6 — cf_collection_sessions (รอบเก็บกลุ่ม · cross-check ที่นี่)
// =============================================================
model CfCollectionSession {
  id                String          @id @default(uuid()) @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  groupId           String?         @map("group_id") @db.Uuid
  branchId          String?         @map("branch_id") @db.Uuid
  sessionCode       String          @map("session_code") // CFS-2569-NNNNNN · unique per org (not global)
  openedAt          DateTime        @default(now()) @map("opened_at") @db.Timestamptz(6)
  openedById        String          @map("opened_by_id") @db.Uuid
  closedAt          DateTime?       @map("closed_at") @db.Timestamptz(6)
  closedById        String?         @map("closed_by_id") @db.Uuid
  status            CfSessionStatus @default(OPEN)
  // group cross-check result (filled by trigger ที่ status = CLOSED · legacy group model)
  exchangerCoinsOut Int?            @map("exchanger_coins_out")
  clawCoinsIn       Int?            @map("claw_coins_in")
  coinVarianceBps   Int?            @map("coin_variance_bps")
  // v2 branch cross-check snapshot (filled app-layer at close · cash + prize)
  expectedCashCents Int?            @map("expected_cash_cents")
  actualCashCents   Int?            @map("actual_cash_cents")
  cashVarianceBps   Int?            @map("cash_variance_bps")
  prizeMeterOut     Int?            @map("prize_meter_out")
  prizeCountedOut   Int?            @map("prize_counted_out")
  prizeVariance     Int?            @map("prize_variance")
  totalCashCents    Int             @default(0) @map("total_cash_cents")
  anomalyFlags      String[]        @default([]) @map("anomaly_flags")
  reviewerId        String?         @map("reviewer_id") @db.Uuid
  reviewedAt        DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  reviewNote        String?         @map("review_note")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  org      Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  group    CfMachineGroup?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  branch   Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy User                @relation("CfSessionOpener", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy User?               @relation("CfSessionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  reviewer User?               @relation("CfSessionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  events   CfCollectionEvent[]

  @@unique([orgId, sessionCode])
  @@index([orgId, groupId, openedAt(sort: Desc)])
  @@index([orgId, branchId, openedAt(sort: Desc)])
  @@index([orgId, status])
  @@map("cf_collection_sessions")
  @@schema("public")
}

// =============================================================
// CF.7 — cf_collection_events (รายตู้ใน session)
// =============================================================
model CfCollectionEvent {
  id                  String      @id @default(uuid()) @db.Uuid
  orgId               String      @map("org_id") @db.Uuid
  sessionId           String?     @map("session_id") @db.Uuid // null สำหรับ INITIAL/VOID
  machineId           String      @map("machine_id") @db.Uuid
  eventType           CfEventType @default(COLLECTION) @map("event_type")
  collectedAt         DateTime    @map("collected_at") @db.Timestamptz(6)
  collectedById       String      @map("collected_by_id") @db.Uuid
  // ทุก kind
  coinMeterBefore     Int         @map("coin_meter_before")
  coinMeterAfter      Int         @map("coin_meter_after")
  cashCountedCents    Int         @map("cash_counted_cents")
  // CLAW only (nullable for EXCHANGER)
  dollMeterBefore     Int?        @map("doll_meter_before")
  dollMeterAfter      Int?        @map("doll_meter_after")
  stockBefore         Int?        @map("stock_before")
  stockAfter          Int?        @map("stock_after")
  refillQty           Int?        @map("refill_qty")
  // EXCHANGER only (nullable for CLAW)
  promoCoinsDispensed Int?        @map("promo_coins_dispensed") // เหรียญที่แจกจาก promo (รวมใน meter แล้ว · บันทึกแยกเพื่อ G6)
  // photos (R2 URLs) · 5 per machine in v2 (coin meter · prize meter · prize before · prize after · cash)
  photoMeterBeforeUrl String?     @map("photo_meter_before_url")
  photoPrizeMeterUrl  String?     @map("photo_prize_meter_url")
  photoCashUrl        String?     @map("photo_cash_url")
  photoMeterAfterUrl  String?     @map("photo_meter_after_url")
  photoStockUrl       String?     @map("photo_stock_url")
  photosPurgedAt      DateTime?   @map("photos_purged_at") @db.Timestamptz(6)
  // anomaly flags ราย event (เก็บแยกจาก session-level)
  anomalyFlags        String[]    @default([]) @map("anomaly_flags")
  notes               String?
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session     CfCollectionSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  machine     CfMachine            @relation(fields: [machineId], references: [id], onDelete: Restrict)
  collectedBy User                 @relation("CfEventCollector", fields: [collectedById], references: [id], onDelete: Restrict)

  @@index([orgId, machineId, collectedAt(sort: Desc)])
  @@index([sessionId])
  @@index([orgId, eventType, collectedAt(sort: Desc)])
  @@map("cf_collection_events")
  @@schema("public")
}

// =============================================================
// CF.8 — cf_stock_movements (รับเข้า + เติมเข้าตู้ + นับ + ปรับ)
// =============================================================
model CfStockMovement {
  id            String          @id @default(uuid()) @db.Uuid
  orgId         String          @map("org_id") @db.Uuid
  branchId      String          @map("branch_id") @db.Uuid
  type          CfStockMoveType
  productId     String          @map("product_id") @db.Uuid
  machineId     String?         @map("machine_id") @db.Uuid // null สำหรับ RECEIVE / COUNT
  qty           Int // +/− signed (RECEIVE=+, LOAD_TO_MACHINE=-, COUNT=actual, ADJUST=delta)
  refTable      String?         @map("ref_table") // 'cf_collection_events' for LOAD
  refId         String?         @map("ref_id") @db.Uuid
  unitCostCents Int             @default(0) @map("unit_cost_cents") // snapshot ราคาทุนตอน RECEIVE
  receiptR2Key  String?         @map("receipt_r2_key") // ใบเสร็จ
  expectedQty   Int?            @map("expected_qty") // ที่ระบบคาด (สำหรับ COUNT_SNAPSHOT compare)
  varianceQty   Int?            @map("variance_qty") // expected - actual (สำหรับ COUNT)
  reason        String?
  occurredAt    DateTime        @map("occurred_at") @db.Timestamptz(6)
  createdById   String          @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product   CfProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)
  machine   CfMachine?   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  createdBy User         @relation("CfStockCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orgId, branchId, occurredAt(sort: Desc)])
  @@index([orgId, productId, occurredAt(sort: Desc)])
  @@index([orgId, type, occurredAt(sort: Desc)])
  @@index([machineId, occurredAt(sort: Desc)])
  @@map("cf_stock_movements")
  @@schema("public")
}

// =============================================================
// CF.9 — cf_deliveries (v2 · central-warehouse shipments to a branch)
// =============================================================
model CfDelivery {
  id           String           @id @default(uuid()) @db.Uuid
  orgId        String           @map("org_id") @db.Uuid
  branchId     String           @map("branch_id") @db.Uuid
  status       CfDeliveryStatus @default(SCHEDULED)
  fromLocation String           @default("คลังกลาง บางนา") @map("from_location")
  eta          DateTime?        @db.Timestamptz(6)
  itemsCount   Int              @default(0) @map("items_count")
  unitsCount   Int              @default(0) @map("units_count")
  note         String?
  createdById  String           @map("created_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User         @relation("CfDeliveryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orgId, branchId, eta(sort: Desc)])
  @@index([orgId, status])
  @@map("cf_deliveries")
  @@schema("public")
}

// =============================================================
// ChairOps — massage-chair management for 30 branches
// Lives in `chairops` schema (multi-schema · separate from public)
// Source: /Users/patipantantikul/Code/chairops/prisma/schema.prisma
// Renamed: User→ChairopsUser · Branch→ChairopsBranch · AuditLog→ChairopsAuditLog
//          UserRole→ChairopsUserRole (Pool already has UserRole)
// =============================================================

enum ChairopsUserRole {
  ADMIN
  CEO
  MANAGER
  OFFICE
  MAID
  TECHNICIAN

  @@schema("chairops")
}

enum ChairopsAlertLevel {
  INFO
  WARN
  CRITICAL

  @@schema("chairops")
}

enum OffboardingReason {
  RESIGNED
  TERMINATED
  TRANSFERRED
  OTHER

  @@schema("chairops")
}

enum ChairopsAlertStatus {
  OPEN
  ACK
  RESOLVED
  IGNORED

  @@schema("chairops")
}

enum ChairopsAlertKind {
  SHORTAGE
  MISSED_COLLECTION
  POS_NOT_INGESTED
  CHAIR_OFFLINE
  CLEANLINESS_FAIL
  REPAIR_OVERDUE
  WRITE_OFF_REQUESTED

  @@schema("chairops")
}

enum ChairopsTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_PARTS
  DONE
  CANCELLED

  @@schema("chairops")
}

enum ChairopsCleanlinessGrade {
  PASS
  WARN
  FAIL

  @@schema("chairops")
}

// Where a cash-collection row came from · drives the photo-required CHECK
// constraint on ChairopsCashCollection (MAID_MANUAL still requires
// evidencePhotoUrl + imageHash · CSV_IMPORT / OFFICE_PROXY may omit them).
enum CollectionSource {
  MAID_MANUAL
  CSV_IMPORT
  OFFICE_PROXY

  @@schema("chairops")
}

model ChairopsBranch {
  id          String    @id @default(uuid())
  orgId       String
  slug        String
  name        String
  tabName     String
  parenNumber Int?
  city        String?
  region      String?
  mallGroup   String?
  floor       String?
  isActive    Boolean   @default(true)
  openedAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Cost fields (admin-tier visibility only · per SPEC §2.11 Owner pre-commit #1)
  monthlyRent     Decimal? @db.Decimal(12, 2)
  monthlyUtility  Decimal? @db.Decimal(12, 2)
  monthlyStaff    Decimal? @db.Decimal(12, 2)
  monthlyOther    Decimal? @db.Decimal(12, 2)
  securityDeposit Decimal? @db.Decimal(12, 2)

  // Drift refactor (SPEC §2.3) — anchors per-branch reconcile window
  lastReconcileClosedAt DateTime?

  // Alert routing (Owner pre-commit #2 · SPEC §2.11)
  secondaryAlertUserId String?
  secondaryAlertUser   ChairopsUser? @relation("chairops_secondary_alert", fields: [secondaryAlertUserId], references: [id])

  chairs             ChairopsChair[]
  chairMovesFrom     ChairopsChairMove[]          @relation("chairmove_from")
  chairMovesTo       ChairopsChairMove[]          @relation("chairmove_to")
  maidAssignments    ChairopsMaidAssignment[]
  posDaily           ChairopsPosDaily[]
  cashCollections    ChairopsCashCollection[]
  cashDeposits       ChairopsCashDeposit[]
  drifts             ChairopsDrift[]
  alerts             ChairopsAlert[]
  damageTickets      ChairopsDamageTicket[]
  cleanlinessReports ChairopsCleanlinessReport[]
  dailyRevenue       ChairopsBranchDailyRevenue[]
  cashEvents         ChairopsPosCashEvent[]
  coinEvents         ChairopsPosCoinEvent[]
  vendorBills        ChairopsVendorBill[]

  @@unique([orgId, slug])
  @@unique([orgId, tabName])
  @@index([orgId])
  @@schema("chairops")
}

model ChairopsUser {
  id                  String             @id @default(uuid())
  orgId               String
  // Links to Supabase auth.users.id — same id space as Pool's users
  authUserId          String?
  email               String?
  phone               String?
  lineUserId          String?
  // Cached LINE profile of the bound account (CEO 2026-06-18) — so the Users admin
  // page shows WHO is linked, not just the opaque lineUserId. Set at line-login bind.
  lineDisplayName     String?
  linePictureUrl      String?
  displayName         String
  role                ChairopsUserRole
  isActive            Boolean            @default(true)
  primaryBranchId     String?
  // Payroll / HR info (CEO 2026-06-03) — for future payroll runs. `phone`
  // already exists above. Bank details + employment-contract attachment.
  bankName            String?
  bankAccountNo       String?
  bankAccountName     String?
  contractFileUrl     String?
  contractFileName    String?
  // F5: invite token stored in DB for revocation
  inviteToken         String?            @unique @map("invite_token")
  inviteExpiresAt     DateTime?          @map("invite_expires_at") @db.Timestamptz(6)
  // F4: self-onboarding (5 fields maid fills on first login)
  mobilePhone         String?            @map("mobile_phone")
  emergencyContact    String?            @map("emergency_contact")
  emergencyPhone      String?            @map("emergency_phone")
  currentMainEmployer String?            @map("current_main_employer")
  onboardingComplete  Boolean            @default(false) @map("onboarding_complete")
  // F7: deactivation reason + audit trail
  deactivatedAt       DateTime?          @map("deactivated_at") @db.Timestamptz(6)
  deactivatedById     String?            @map("deactivated_by_id")
  offboardingReason   OffboardingReason? @map("offboarding_reason")
  offboardingNote     String?            @map("offboarding_note")
  // S1: cover branch (secondary assignment)
  secondaryBranchId   String?            @map("secondary_branch_id")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  maidAssignments         ChairopsMaidAssignment[]
  cashCollections         ChairopsCashCollection[]
  cashCollectionsImported ChairopsCashCollection[]    @relation("CashCollectionImporter")
  cashDeposits            ChairopsCashDeposit[]
  chairMovesBy            ChairopsChairMove[]
  posDailyEntries         ChairopsPosDaily[]
  damageReported          ChairopsDamageTicket[]      @relation("chairops_damage_reported_by")
  damageAssigned          ChairopsDamageTicket[]      @relation("chairops_damage_assigned_to")
  cleanlinessByMaid       ChairopsCleanlinessReport[] @relation("chairops_cleanliness_by_maid")
  cleanlinessByAuditor    ChairopsCleanlinessReport[] @relation("chairops_cleanliness_by_auditor")
  auditLogs               ChairopsAuditLog[]
  alertsAcked             ChairopsAlert[]             @relation("chairops_alerts_acked_by")
  writeOffsByMaker        ChairopsWriteOff[]          @relation("chairops_writeoffs_maker")
  writeOffsByApprover     ChairopsWriteOff[]          @relation("chairops_writeoffs_approver")
  branchesSecondaryAlert  ChairopsBranch[]            @relation("chairops_secondary_alert")
  // BF1 — Day-off + Daily-pay ledger (2026-06-02)
  daysOff                 ChairopsMaidDayOff[]        @relation("chairops_maid_dayoff_maid")
  daysOffCreated          ChairopsMaidDayOff[]        @relation("chairops_maid_dayoff_created_by")
  dailyPay                ChairopsMaidDailyPay[]      @relation("chairops_maid_dailypay_maid")
  dailyPayPaid            ChairopsMaidDailyPay[]      @relation("chairops_maid_dailypay_paid_by")

  @@unique([orgId, authUserId])
  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@unique([orgId, lineUserId])
  @@index([orgId])
  @@index([role])
  @@index([primaryBranchId])
  @@schema("chairops")
}

model ChairopsMaidAssignment {
  id        String    @id @default(uuid())
  orgId     String
  userId    String
  branchId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  isActive  Boolean   @default(true)

  user   ChairopsUser   @relation(fields: [userId], references: [id])
  branch ChairopsBranch @relation(fields: [branchId], references: [id])

  @@index([orgId])
  @@index([branchId, isActive])
  @@index([userId, isActive])
  // NOTE: A partial unique index ((userId) WHERE endedAt IS NULL AND isActive)
  // is enforced at the DB level via the BF1 migration. Prisma 5 cannot express
  // partial indexes; rely on the SQL migration + P2002 handling in actions.
  @@schema("chairops")
}

// BF1 · Day-off ledger (DEVIL minimalist). 1 row = 1 maid + 1 date.
// DELETE to revoke. NO range cols, NO approval workflow. If maid wants 3 days
// off the UI loops INSERT 3 rows in one prisma.$transaction.
model ChairopsMaidDayOff {
  id          String   @id @default(uuid())
  orgId       String
  maidId      String
  date        DateTime @db.Date
  reason      String?
  createdById String
  createdAt   DateTime @default(now())

  maid      ChairopsUser @relation("chairops_maid_dayoff_maid", fields: [maidId], references: [id])
  createdBy ChairopsUser @relation("chairops_maid_dayoff_created_by", fields: [createdById], references: [id])

  @@unique([orgId, maidId, date])
  @@index([orgId, date])
  @@index([maidId, date(sort: Desc)])
  @@schema("chairops")
}

// BF1 · Daily pay ledger (manual entry, no formula). Amount can be negative
// for deductions (e.g. uniform · "หักค่าชุด") per BA Q7 default.
model ChairopsMaidDailyPay {
  id       String   @id @default(uuid())
  orgId    String
  maidId   String
  date     DateTime @db.Date
  amount   Int
  note     String?
  paidById String
  paidAt   DateTime @default(now())

  maid   ChairopsUser @relation("chairops_maid_dailypay_maid", fields: [maidId], references: [id])
  paidBy ChairopsUser @relation("chairops_maid_dailypay_paid_by", fields: [paidById], references: [id])

  @@unique([orgId, maidId, date])
  @@index([orgId, date])
  @@index([maidId, date(sort: Desc)])
  @@schema("chairops")
}

model ChairopsChair {
  id            String    @id @default(uuid())
  orgId         String
  chairCode     String
  branchId      String
  generation    String?
  pricePerCycle Int?
  isOnline      Boolean   @default(true)
  isActive      Boolean   @default(true)
  installedAt   DateTime?
  retiredAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch        ChairopsBranch         @relation(fields: [branchId], references: [id])
  damageTickets ChairopsDamageTicket[]
  moves         ChairopsChairMove[]

  @@unique([orgId, chairCode])
  @@index([orgId])
  @@index([branchId])
  @@index([generation])
  @@schema("chairops")
}

// Chair-move history (Plan 2 per CEO 2026-05-31). One row per branch change.
// fromBranchId is nullable (first placement when the chair was created).
// source = "manual" | "starthing_import" | other ingest channels.
//
// Revenue rows (PosDaily / CashCollection / BranchDailyRevenue) already
// snapshot branchId at event time, so historical attribution is preserved
// regardless of moves. This table answers "where has chair G0322099 been?"
// without scanning audit_log JSON.
model ChairopsChairMove {
  id           String   @id @default(uuid())
  orgId        String
  chairId      String
  fromBranchId String?
  toBranchId   String
  movedAt      DateTime @default(now())
  movedById    String?
  source       String   @default("manual")
  notes        String?
  createdAt    DateTime @default(now())

  chair      ChairopsChair   @relation(fields: [chairId], references: [id])
  fromBranch ChairopsBranch? @relation("chairmove_from", fields: [fromBranchId], references: [id])
  toBranch   ChairopsBranch  @relation("chairmove_to", fields: [toBranchId], references: [id])
  movedBy    ChairopsUser?   @relation(fields: [movedById], references: [id])

  @@index([orgId])
  @@index([chairId, movedAt])
  @@index([toBranchId, movedAt])
  @@schema("chairops")
}

model ChairopsPosImport {
  id           String    @id @default(uuid())
  orgId        String
  filename     String
  uploadedById String
  uploadedAt   DateTime  @default(now())
  fileHash     String
  rowCount     Int
  diffSummary  Json
  committed    Boolean   @default(false)
  committedAt  DateTime?
  notes        String?

  dailyRevenue ChairopsBranchDailyRevenue[]
  cashEvents   ChairopsPosCashEvent[]
  coinEvents   ChairopsPosCoinEvent[]

  @@unique([orgId, fileHash])
  @@index([orgId])
  @@index([uploadedAt])
  @@schema("chairops")
}

model ChairopsPosDaily {
  id              String   @id @default(uuid())
  orgId           String
  branchId        String
  chairCode       String?
  bizDate         DateTime @db.Date
  onlineTotal     Decimal  @default(0) @db.Decimal(12, 2)
  cashTotal       Decimal  @default(0) @db.Decimal(12, 2)
  coinInsertCount Int      @default(0)
  totalCash       Decimal  @default(0) @db.Decimal(12, 2)
  grossTotal      Decimal  @default(0) @db.Decimal(12, 2)
  rawSource       String?
  importId        String?
  enteredById     String
  enteredAt       DateTime @default(now())
  notes           String?

  branch ChairopsBranch @relation(fields: [branchId], references: [id])
  user   ChairopsUser   @relation(fields: [enteredById], references: [id])

  @@unique([orgId, branchId, chairCode, bizDate])
  @@index([orgId])
  @@index([branchId, bizDate])
  @@index([bizDate])
  @@schema("chairops")
}

model ChairopsCashCollection {
  id               String               @id @default(uuid())
  orgId            String
  branchId         String
  maidId           String
  collectedAt      DateTime             @default(now())
  countedAmount    Int
  // Step-2 deposit columns kept for backward compat with rows written before
  // the deposit-table split (2026-05-30). NEW writes leave these at 0/null
  // and instead create a ChairopsCashDeposit row that this collection's
  // depositId points to. Drift engine sums depositedAmount from the new
  // table.
  depositedAmount  Int                  @default(0)
  // 2026-06-02 · MAID_MANUAL still requires evidencePhotoUrl + imageHash
  // (enforced by DB CHECK constraint).
  // CSV_IMPORT / OFFICE_PROXY rows may leave them NULL.
  evidencePhotoUrl String?
  slipPhotoUrl     String?
  imageHash        String?
  notes            String?
  // F1 (audit MISS-04) · provenance for CSV-imported maid rounds.
  // FK to ChairopsUser via "CashCollectionImporter" relation · ON DELETE
  // SET NULL so removing the admin who pasted the CSV nulls this pointer
  // instead of leaving a dangling string (audit SA-1, 2026-06-03).
  source           CollectionSource     @default(MAID_MANUAL)
  importedById     String?
  importer         ChairopsUser?        @relation("CashCollectionImporter", fields: [importedById], references: [id], onDelete: SetNull)
  // Per-chair breakdown captured by the maid at Step 1. Shape:
  //   { lines: [{ chairCode, status: "collected"|"broken"|"empty"|"skipped",
  //               amount: number, reason?: string, photoUrl?: string }, ...] }
  // countedAmount must equal SUM(line.amount). Nullable for rows written
  // before this column existed (legacy free-text "[CH-001]" prefix in notes).
  chairBreakdown   Json?
  // null = pending deposit · set when maid lumps this round into a
  // ChairopsCashDeposit. Many collections can share one depositId (batch
  // deposit to save bank fees).
  depositId        String?
  deposit          ChairopsCashDeposit? @relation(fields: [depositId], references: [id])
  lockedAt         DateTime?
  unlockedById     String?
  unlockedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  branch ChairopsBranch @relation(fields: [branchId], references: [id])
  maid   ChairopsUser   @relation(fields: [maidId], references: [id])

  @@unique([orgId, imageHash])
  @@index([orgId])
  @@index([branchId, collectedAt])
  @@index([maidId, collectedAt])
  @@index([branchId, depositId])
  @@schema("chairops")
}

// Bank-deposit event — one row per actual trip to the bank, can cover N
// collection rounds (batch deposit to save bank fees per CEO 2026-05-30).
// depositedAmount is what landed in the bank account (≤ sum of covered
// collections.countedAmount in most cases · bankFee separate).
model ChairopsCashDeposit {
  id              String   @id @default(uuid())
  orgId           String
  branchId        String
  maidId          String
  depositedAt     DateTime @default(now())
  depositedAmount Int
  bankFee         Int      @default(0)
  slipPhotoUrl    String
  slipImageHash   String
  notes           String?
  // BF1 MAID-04 anti-fraud · auto-flagged TRUE when |diff| >= 500 ฿ ·
  // office staff clears via reconcile flow. Indexed partial in migration.
  requiresReview  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch      ChairopsBranch           @relation(fields: [branchId], references: [id])
  maid        ChairopsUser             @relation(fields: [maidId], references: [id])
  collections ChairopsCashCollection[]

  @@unique([orgId, slipImageHash])
  @@index([orgId])
  @@index([branchId, depositedAt])
  @@index([maidId, depositedAt])
  @@schema("chairops")
}

model ChairopsDrift {
  id                      String    @id @default(uuid())
  orgId                   String
  branchId                String
  posTotal                Int
  depositTotal            Int
  driftAmount             Int
  driftSince              DateTime?
  lastPosDate             DateTime? @db.Date
  lastCollectionAt        DateTime?
  daysSinceLastCollection Int       @default(0)
  lastComputedAt          DateTime  @default(now())

  branch ChairopsBranch @relation(fields: [branchId], references: [id])

  @@unique([orgId, branchId])
  @@index([orgId])
  @@schema("chairops")
}

model ChairopsAlert {
  id          String              @id @default(uuid())
  orgId       String
  branchId    String?
  kind        ChairopsAlertKind
  level       ChairopsAlertLevel
  status      ChairopsAlertStatus @default(OPEN)
  title       String
  message     String
  contextJson Json?
  ackedById   String?
  ackedAt     DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())

  branch  ChairopsBranch? @relation(fields: [branchId], references: [id])
  ackedBy ChairopsUser?   @relation("chairops_alerts_acked_by", fields: [ackedById], references: [id])

  @@index([orgId])
  @@index([status, level])
  @@index([branchId, status])
  @@index([createdAt])
  @@schema("chairops")
}

model ChairopsWriteOff {
  id         String    @id @default(uuid())
  orgId      String
  branchId   String
  amount     Int
  reason     String
  makerId    String
  makerAt    DateTime  @default(now())
  approverId String?
  approverAt DateTime?
