// =============================================================
// FUELOS (migrated from pooil-fuel) — schema "fuel"
// renamed to avoid Pool collisions: User->FuelUser, AuditLog->FuelAuditLog,
// InboxChannel->FuelInboxChannel, enum UserRole->FuelUserRole
// =============================================================
// ---------- enums ----------
enum FuelUserRole {
  OWNER // CEO
  SALES_HEAD // หัวหน้าขาย
  SALES // เซลล์
  FINANCE // การเงิน/เครดิต
  DISPATCH // ฝ่ายจัดส่ง
  DRIVER // คนขับ
  ADMIN

  // DB enum type จริงชื่อ "UserRole" (จาก pooil-fuel เดิม) — เราเปลี่ยนชื่อ Prisma enum
  // เป็น FuelUserRole กันชนกับ Pool แต่ต้อง @@map กลับไปชื่อ DB เดิม ไม่งั้น Prisma
  // หา type "fuel.FuelUserRole" ไม่เจอ → ทุก read/write role พัง (B-019/enum-drift)
  @@map("UserRole")
  @@schema("fuel")
}

enum ProductType {
  B7
  B10
  B20
  GASOHOL_91
  GASOHOL_95
  E20
  E85

  @@schema("fuel")
}

enum ConvStatus {
  OPEN
  SNOOZED
  CLOSED

  @@schema("fuel")
}

enum ConvSegment {
  NEW // ลูกค้าใหม่ (ติดป้ายเอง)
  OLD // เคยซื้อแล้ว (auto เมื่อมี order แรก)
  PRICE_CHECK // เช็คราคาเฉย ๆ ยังไม่ซื้อ

  @@schema("fuel")
}

enum MsgDirection {
  IN
  OUT

  @@schema("fuel")
}

enum SenderType {
  CUSTOMER
  STAFF
  BOT

  @@schema("fuel")
}

enum QuoteStatus {
  PENDING
  WON
  LOST
  DECLINED
  NO_RESPONSE

  @@schema("fuel")
}

enum OrderStatus {
  AWAITING_CONFIRM // รอยืนยัน/รอจัดส่ง
  DELIVERING // กำลังจัดส่ง/รถออกแล้ว
  DELIVERED_UNPAID // ส่งแล้ว/รอเก็บเงิน
  CLOSED // ปิดบิล/จบ
  CANCELLED

  @@schema("fuel")
}

enum PaymentMethod {
  TRANSFER
  CASH
  CHEQUE

  @@schema("fuel")
}

enum PaymentStatus {
  PENDING // รอการเงินยืนยัน
  VERIFIED
  REJECTED

  @@schema("fuel")
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED

  @@schema("fuel")
}

enum CreditApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("fuel")
}

enum TruckStatus {
  IDLE
  LOADED
  DISPATCHED
  MAINTENANCE

  @@schema("fuel")
}

enum FollowUpStatus {
  OPEN
  DONE

  @@schema("fuel")
}

// ---------- core / auth ----------
model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  users           FuelUser[]
  customers       Customer[]
  depotPrices     DepotPrice[]
  zoneMargins     ZoneMargin[]
  conversations   Conversation[]
  quotes          Quote[]
  orders          Order[]
  trucks          Truck[]
  payments        Payment[]
  cheques         Cheque[]
  bankAccounts    BankAccount[]
  botFaqs         BotFaq[]
  followUps       FollowUp[]
  auditLogs       FuelAuditLog[]
  channels        FuelInboxChannel[]
  creditApprovals CreditApproval[]
  salesInvoices   SalesInvoice[]

  @@map("orgs")
  @@schema("fuel")
}

// ใบกำกับภาษีขายส่งน้ำมัน — ดึงจาก TRCloud บริษัท 44 (ขายส่งน้ำมันทั้งหมด · แยกจากบัญชี/ledger)
// อ่านอย่างเดียว: TRCloud เป็น source of truth · เราเก็บ snapshot ไว้โชว์ยอดขาย/ลูกหนี้
// ค้างชำระ = grandTotal − paidAmount (TRCloud ส่ง payment มากับใบ → จ่ายบางส่วนได้แม่น)
model SalesInvoice {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  // TRCloud identity (company 44)
  trcloudInvoiceId String    @map("trcloud_invoice_id") // invoice_id — unique key สำหรับกันซ้ำ
  companyFormat    String?   @map("company_format") // ซีรีส์เอกสาร: JK_IV / YMSALE_IV / POP_IV ...
  invoiceNumber    String    @map("invoice_number")
  docNo            String    @map("doc_no") // เลขใบที่โชว์ (ซีรีส์ + เลข)
  // customer
  contactId        String?   @map("contact_id") // รหัสลูกค้า TRCloud (คงที่ → จับยอดรายลูกค้า)
  customerName     String    @map("customer_name")
  customerOrg      String?   @map("customer_org")
  customerBranch   String?   @map("customer_branch")
  customerTaxId    String?   @map("customer_tax_id")
  // dates
  issueDate        DateTime  @map("issue_date") @db.Date
  dueDate          DateTime? @map("due_date") @db.Date
  paidDate         DateTime? @map("paid_date") @db.Date // วันจ่ายล่าสุด (จากใบเสร็จ RV ที่อ้างใบนี้)
  // money (บาท · Decimal)
  netTotal         Decimal   @default(0) @map("net_total") @db.Decimal(15, 2) // ก่อน VAT
  vatTotal         Decimal   @default(0) @map("vat_total") @db.Decimal(15, 2)
  grandTotal       Decimal   @default(0) @map("grand_total") @db.Decimal(15, 2) // รวม VAT = ยอดขาย
  paidAmount       Decimal   @default(0) @map("paid_amount") @db.Decimal(15, 2) // จ่ายมาแล้ว (TRCloud payment)
  outstanding      Decimal   @default(0) @map("outstanding") @db.Decimal(15, 2) // ค้าง = grand − paid
  // status
  trcloudStatus    String?   @map("trcloud_status") // Debtor / Paid / ... (สถานะดิบจาก TRCloud)
  paymentState     String    @default("UNPAID") @map("payment_state") // UNPAID / PARTIAL / PAID (สรุปเอง)
  // meta
  salesman         String?
  department       String?
  project          String?
  docType          String?   @map("doc_type")
  quantity         Decimal   @default(0) @db.Decimal(15, 3) // sum_quantity (ลิตร)
  issuedAt         DateTime? @map("issued_at") // create_dt จาก TRCloud
  products         Json?     @map("products") // รายการสินค้า [{code,name,qty,unit,price,total}] (lazy จาก iv/read)
  rawJson          Json?     @map("raw_json")
  syncedAt         DateTime  @default(now()) @map("synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, trcloudInvoiceId])
  @@index([orgId, issueDate])
  @@index([orgId, paymentState])
  @@index([orgId, contactId])
  @@index([orgId, docNo])
  @@map("sales_invoices")
  @@schema("fuel")
}

model FuelUser {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  role         FuelUserRole @default(SALES)
  phone        String?
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  org              Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lineIdentities   StaffLineIdentity[]
  ownedCustomers   Customer[]          @relation("CustomerOwner")
  assignedConvs    Conversation[]      @relation("ConvAssignee")
  sentMessages     Message[]           @relation("MsgStaff")
  quotes           Quote[]             @relation("QuoteSales")
  orders           Order[]             @relation("OrderSales")
  enteredPrices    DepotPrice[]        @relation("PriceEnteredBy")
  followUps        FollowUp[]          @relation("FollowUpSales")
  drivingTrucks    Truck[]             @relation("TruckDriver")
  auditLogs        FuelAuditLog[]
  approvalsAsked   CreditApproval[]    @relation("ApprovalRequester")
  approvalsActed   CreditApproval[]    @relation("ApprovalActor")
  verifiedPayments Payment[]           @relation("PaymentVerifier")

  @@index([orgId, role])
  @@map("users")
  @@schema("fuel")
}

// แมป LINE userId ของพนักงาน → FuelUser (เพื่อรู้ว่า "ใครตอบ" ในกลุ่ม)
model StaffLineIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lineUserId String   @unique @map("line_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user FuelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("staff_line_identities")
  @@schema("fuel")
}

// ---------- F7 pricing ----------
model DepotPrice {
  id          String      @id @default(uuid()) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  date        DateTime    @db.Date
  depotName   String      @map("depot_name") // PTT / Shell / บางจาก
  productType ProductType @map("product_type")
  costPerL    Decimal     @map("cost_per_l") @db.Decimal(10, 4) // ต้นทุนคลัง ฿/ลิตร
  validUntil  DateTime?   @map("valid_until") // เวลาหมดอายุราคา (timestamptz)
  enteredById String?     @map("entered_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enteredBy FuelUser? @relation("PriceEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([orgId, date, depotName, productType])
  @@index([orgId, date])
  @@map("depot_prices")
  @@schema("fuel")
}

model ZoneMargin {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  zoneName      String      @map("zone_name")
  productType   ProductType @map("product_type")
  transportCost Decimal     @default(0) @map("transport_cost") @db.Decimal(10, 4) // ค่าขนส่งคลัง→โซน ฿/ลิตร (แยกจากกำไร)
  baseMargin    Decimal     @map("base_margin") @db.Decimal(10, 4) // กำไรโซน ฿/ลิตร (กำไรล้วน)
  minMargin     Decimal     @map("min_margin") @db.Decimal(10, 4) // กำไรขั้นต่ำ (กันขายต่ำกว่าทุน+ขนส่ง)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, zoneName, productType])
  @@index([orgId, isActive])
  @@map("zone_margins")
  @@schema("fuel")
}

// คลังน้ำมัน (config) — CEO มี 5 คลัง · ใช้แสดงต้นทุนทุกคลังในหน้าราคา
model FuelDepot {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String // ชื่อคลัง (เช่น PTT, บางจาก)
  sort      Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orgId, name])
  @@index([orgId, isActive])
  @@map("depots")
  @@schema("fuel")
}

// ราคาหน้าปั๊มอ้างอิง (ขายปลีก) — เก็บ snapshot รายวันจาก thai-oil-api ไว้ดูย้อนหลัง
// ข้อมูลสาธารณะระดับประเทศ (ไม่ผูก org) · cron บันทึกวันละ 1 ครั้ง · 1 แถว/วัน/ปั๊ม/ผลิตภัณฑ์
model FuelPumpPriceSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  date         DateTime @db.Date // วันที่บันทึก (เวลาไทย) = คีย์กันซ้ำ 1 แถว/วัน
  sourceDate   String?  @map("source_date") // วันที่ตาม source (string ไทย) เผื่ออ้างอิง
  stationKey   String   @map("station_key") // ptt / bcp / shell ...
  stationLabel String   @map("station_label")
  productName  String   @map("product_name")
  price        Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([date, stationKey, productName])
  @@index([date])
  @@index([stationKey, productName, date])
  @@map("fuel_pump_price_snapshot")
  @@schema("fuel")
}

// ตำแหน่งรถจาก xsense GPS (positionlog.plus.xsense.co.th) — ทั้งกองรถ (หลายบริษัท)
// poll จาก xsense /vehicle/tracking → upsert ที่นี่ · แยกจาก Truck (รถส่งของ) เพราะกองรถใหญ่กว่า
model FuelGpsVehicle {
  id         String    @id @default(uuid()) @db.Uuid
  xsenseName String    @unique @map("xsense_name") // "70-6630|นม" (คีย์จาก xsense)
  plate      String? // "70-6630"
  province   String? // "นม"
  groupName  String?   @map("group_name") // บริษัท (จักราชฯ / พีโอออยล์ ...)
  deviceId   String?   @map("device_id") // IMEI (ถ้ามี)
  driverId   String?   @map("driver_id")
  driverName String?   @map("driver_name")
  lat        Decimal?  @db.Decimal(10, 7)
  lng        Decimal?  @db.Decimal(10, 7)
  speedKmh   Decimal?  @map("speed_kmh") @db.Decimal(6, 2)
  engineOn   Boolean?  @map("engine_on") // engineStatus 1=ติดเครื่อง
  moving     Boolean? // vehicleStatus 'R'=กำลังวิ่ง
  courseDeg  Int?      @map("course_deg")
  address    String? // position (ที่อยู่ไทย ตำบล:อำเภอ:จังหวัด)
  gpsTime    DateTime? @map("gps_time")
  seenAt     DateTime  @default(now()) @map("seen_at") // เวลา poll/อัปเดตล่าสุด
  createdAt  DateTime  @default(now()) @map("created_at")

  // ฐานกระทบยอดน้ำมัน — null จนกว่า xsense คาลิเบรทเซ็นเซอร์ (เติมโดย daily refresh /vehicle)
  fuelPct     Decimal? @map("fuel_pct") @db.Decimal(5, 2)
  fuelRawAdc3 Int?     @map("fuel_raw_adc3")
  odometerKm  Decimal? @map("odometer_km") @db.Decimal(14, 2)

  @@index([groupName])
  @@map("fuel_gps_vehicle")
  @@schema("fuel")
}

// คีย์ API ของ xsense เก็บในเว็บ (เข้ารหัส · RULE J: env FUELOS_XSENSE_CRYPTO_KEY)
// ตัวอ่านคีย์ (lib/fuelos/gps/creds) เช็ค DB ก่อน → fallback env FUELOS_XSENSE_API_ID/KEY (ของเดิม)
model FuelGpsConfig {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @unique @map("org_id") @db.Uuid
  apiIdEnc       String?   @map("api_id_enc")
  apiKeyEnc      String?   @map("api_key_enc")
  enabled        Boolean   @default(false)
  accountName    String?   @map("account_name")
  quotaTotal     Int?      @map("quota_total")
  quotaUsed      Int?      @map("quota_used")
  quotaUnlimited Boolean?  @map("quota_unlimited")
  trackedGroups  String[]  @default(["ALL"]) @map("tracked_groups")
  lastSyncAt     DateTime? @map("last_sync_at")
  lastTestAt     DateTime? @map("last_test_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("gps_configs")
  @@schema("fuel")
}

// สรุปรายวันต่อคัน (จาก /next/history) — ฐานรายงาน กม./idle/น้ำมัน · key=xsenseName (ตาม fuel_gps_vehicle)
model FuelGpsDailyStat {
  id              String   @id @default(uuid()) @db.Uuid
  xsenseName      String   @map("xsense_name")
  statDate        DateTime @map("stat_date") @db.Date
  distanceKm      Decimal  @default(0) @map("distance_km") @db.Decimal(10, 2)
  moveSeconds     Int      @default(0) @map("move_seconds")
  idleSeconds     Int      @default(0) @map("idle_seconds")
  stopSeconds     Int      @default(0) @map("stop_seconds")
  noSignalSeconds Int      @default(0) @map("no_signal_seconds")
  pointCount      Int      @default(0) @map("point_count")
  fuelStartPct    Decimal? @map("fuel_start_pct") @db.Decimal(5, 2)
  fuelEndPct      Decimal? @map("fuel_end_pct") @db.Decimal(5, 2)
  litresFilled    Decimal? @map("litres_filled") @db.Decimal(10, 2)
  litresConsumed  Decimal? @map("litres_consumed") @db.Decimal(10, 2)
  syncedAt        DateTime @default(now()) @map("synced_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([xsenseName, statDate], map: "fuel_gps_daily_stat_name_date_key")
  @@index([statDate])
  @@map("gps_daily_stats")
  @@schema("fuel")
}

// ---------- F5 CRM (1 group = 1 customer/company) ----------
model Customer {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  name              String // ชื่อเรียก
  nickname          String? // ชื่อเล่น (เรียกตอนคุย/โทร)
  legalName         String?   @map("legal_name") // ชื่อนิติบุคคล (ออกใบ)
  taxId             String?   @map("tax_id")
  phone             String?
  zone              String?
  province          String?
  assignedSalesId   String?   @map("assigned_sales_id") @db.Uuid // เจ้าของหลัก
  creditLimit       Decimal?  @map("credit_limit") @db.Decimal(15, 2)
  creditUsed        Decimal   @default(0) @map("credit_used") @db.Decimal(15, 2)
  paymentTerms      Int?      @map("payment_terms") // วัน; null = COD
  // CRM health (F3/F5)
  firstOrderAt      DateTime? @map("first_order_at") // มี = ลูกค้าเก่า
  lastOrderAt       DateTime? @map("last_order_at")
  lastQuoteAt       DateTime? @map("last_quote_at")
  normalCadenceDays Int?      @map("normal_cadence_days") // รอบซื้อปกติ (auto + ปรับได้)
  cadenceManual     Boolean   @default(false) @map("cadence_manual")
  notes             String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  org           Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedSales FuelUser?          @relation("CustomerOwner", fields: [assignedSalesId], references: [id], onDelete: SetNull)
  locations     DeliveryLocation[]
  conversations Conversation[]
  quotes        Quote[]
  orders        Order[]
  payments      Payment[]
  cheques       Cheque[]
  creditDocs    CreditDocument[]
  followUps     FollowUp[]

  @@index([orgId, isActive])
  @@index([assignedSalesId])
  @@index([orgId, lastOrderAt])
  @@index([orgId, isActive, lastOrderAt])
  @@map("customers")
  @@schema("fuel")
}

model DeliveryLocation {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  name         String
  address      String?
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  zone         String?
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
  @@map("delivery_locations")
  @@schema("fuel")
}

// ---------- F1/F2 Inbox (LINE OA + groups) ----------
model FuelInboxChannel {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  displayName    String   @map("display_name")
  externalId     String?  @map("external_id") // LINE channel id
  accessTokenEnc String?  @map("access_token_enc")
  webhookSecret  String?  @map("webhook_secret")
  botEnabled     Boolean  @default(false) @map("bot_enabled")
  status         String   @default("setup") // setup | active | error
  createdAt      DateTime @default(now()) @map("created_at")

  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("inbox_channels")
  @@schema("fuel")
}

// แต่ละคน (LINE userId) ในกลุ่ม/แชท — เก็บชื่อจริงจาก LINE + รูปโปรไฟล์
// + alias ที่พนักงานตั้งเอง (rename ได้ · ยังดูชื่อจริงได้) + ป้ายบทบาท (เถ้าแก่/บัญชี)
// keyed (channelId, lineUserId) · ไม่มี relation เพื่อเลี่ยงแก้ Org/Channel (scope ด้วย orgId column)
model FuelLineContact {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  channelId   String    @map("channel_id") @db.Uuid
  lineUserId  String    @map("line_user_id")
  displayName String?   @map("display_name") // ชื่อจริงจาก LINE (original · อ่านอย่างเดียว)
  pictureUrl  String?   @map("picture_url") // รูปโปรไฟล์จาก LINE
  alias       String? // ชื่อที่พนักงานตั้งเอง (rename)
  roleLabel   String?   @map("role_label") // ป้าย เช่น เถ้าแก่ / บัญชี / จัดซื้อ
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([channelId, lineUserId])
  @@index([orgId])
  @@map("line_contacts")
  @@schema("fuel")
}

model Conversation {
  id               String      @id @default(uuid()) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  channelId        String?     @map("channel_id") @db.Uuid
  lineGroupId      String?     @map("line_group_id") // groupId (1 กลุ่ม = 1 ลูกค้า)
  externalUserId   String?     @map("external_user_id") // กรณี 1:1
  customerId       String?     @map("customer_id") @db.Uuid
  displayName      String?     @map("display_name")
  pictureUrl       String?     @map("picture_url") // รูปกลุ่ม/โปรไฟล์ LINE (cache ครั้งแรก)
  lineGroupName    String?     @map("line_group_name") // ชื่อกลุ่มจาก LINE (cache)
  status           ConvStatus  @default(OPEN)
  segment          ConvSegment @default(NEW)
  assignedToId     String?     @map("assigned_to_id") @db.Uuid // เจ้าของหลัก
  isUnanswered     Boolean     @default(false) @map("is_unanswered") // ลูกค้าพิมพ์ล่าสุด ยังไม่มีคนตอบ
  lastInboundAt    DateTime?   @map("last_inbound_at")
  lastStaffReplyAt DateTime?   @map("last_staff_reply_at")
  lastMessageAt    DateTime?   @map("last_message_at")
  unreadCount      Int         @default(0) @map("unread_count")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  org        Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channel    FuelInboxChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo FuelUser?         @relation("ConvAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]
  quotes     Quote[]
  labels     FuelConvLabelLink[]

  @@unique([channelId, lineGroupId])
  @@index([orgId, status])
  @@index([orgId, isUnanswered])
  @@index([assignedToId])
  @@index([orgId, lastMessageAt])
  @@index([orgId, isUnanswered, lastMessageAt])
  @@map("conversations")
  @@schema("fuel")
}

// ป้าย/หมวดหมู่แชทที่ผู้ใช้สร้างเอง (เช่น "ซัพพลายเออร์" "ลูกค้า VIP" "ราคา") — ต่อองค์กร
model FuelConvLabel {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  color     String   @default("brand") // คีย์สีจาก palette (brand/leaf/amber/rose/sky/violet/zinc)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  links FuelConvLabelLink[]

  @@unique([orgId, name])
  @@index([orgId, sortOrder])
  @@map("conv_labels")
  @@schema("fuel")
}

// แชท ↔ ป้าย (many-to-many · 1 แชทติดได้หลายป้าย)
model FuelConvLabelLink {
  conversationId String   @map("conversation_id") @db.Uuid
  labelId        String   @map("label_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        FuelConvLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
  @@map("conv_label_links")
  @@schema("fuel")
}

model Message {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  conversationId   String       @map("conversation_id") @db.Uuid
  direction        MsgDirection
  senderType       SenderType   @map("sender_type")
  senderLineUserId String?      @map("sender_line_user_id")
  senderUserId     String?      @map("sender_user_id") @db.Uuid // staff ที่ตอบ (รู้ว่าใครตอบ)
  body             String
  attachments      Json?
  externalId       String?      @map("external_id")
  sentByBot        Boolean      @default(false) @map("sent_by_bot")
  createdAt        DateTime     @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   FuelUser?    @relation("MsgStaff", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([orgId, createdAt])
  @@map("messages")
  @@schema("fuel")
}

// ---------- F6 Quotes ----------
model Quote {
  id              String      @id @default(uuid()) @db.Uuid
  orgId           String      @map("org_id") @db.Uuid
  quoteNo         String      @map("quote_no")
  customerId      String?     @map("customer_id") @db.Uuid
  prospectName    String?     @map("prospect_name") // ลูกค้าใหม่ยังไม่มีในระบบ
  prospectPhone   String?     @map("prospect_phone")
  salesId         String      @map("sales_id") @db.Uuid
  conversationId  String?     @map("conversation_id") @db.Uuid
  status          QuoteStatus @default(PENDING)
  publicToken     String      @unique @map("public_token") // ลิงก์เปิดหน้าใบราคา
  quoteDate       DateTime    @default(now()) @map("quote_date")
  validUntil      DateTime?   @map("valid_until")
  subtotal        Decimal     @default(0) @db.Decimal(15, 2)
  lostTo          String?     @map("lost_to")
  competitorPrice Decimal?    @map("competitor_price") @db.Decimal(10, 4)
  resultOrderId   String?     @map("result_order_id") @db.Uuid
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sales        FuelUser      @relation("QuoteSales", fields: [salesId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        QuoteItem[]

  @@unique([orgId, quoteNo])
  @@index([orgId, status])
  @@index([salesId, quoteDate])
  @@index([customerId])
  @@map("quotes")
  @@schema("fuel")
}

model QuoteItem {
  id          String      @id @default(uuid()) @db.Uuid
  quoteId     String      @map("quote_id") @db.Uuid
  productType ProductType @map("product_type")
  qtyLiters   Decimal     @map("qty_liters") @db.Decimal(12, 3)
  costPerL    Decimal     @map("cost_per_l") @db.Decimal(10, 4) // snapshot ต้นทุน
  zoneMargin  Decimal     @map("zone_margin") @db.Decimal(10, 4)
  salesMargin Decimal     @default(0) @map("sales_margin") @db.Decimal(10, 4)
  finalPrice  Decimal     @map("final_price") @db.Decimal(10, 4) // ราคาขาย/ลิตร (ล็อกตอนออกใบ)
  lineTotal   Decimal     @map("line_total") @db.Decimal(15, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
  @@schema("fuel")
}

// ---------- F8 Orders ----------
model Order {
  id               String      @id @default(uuid()) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  orderNo          String      @map("order_no")
  customerId       String      @map("customer_id") @db.Uuid
  locationId       String?     @map("location_id") @db.Uuid
  salesId          String      @map("sales_id") @db.Uuid
  sourceQuoteId    String?     @map("source_quote_id") @db.Uuid
  status           OrderStatus @default(AWAITING_CONFIRM)
  scheduledDate    DateTime?   @map("scheduled_date") @db.Date
  deliveredAt      DateTime?   @map("delivered_at")
  truckId          String?     @map("truck_id") @db.Uuid
  driverId         String?     @map("driver_id") @db.Uuid
  deliveryPhotoKey String?     @map("delivery_photo_key")
  deliveryLat      Decimal?    @map("delivery_lat") @db.Decimal(10, 7)
  deliveryLng      Decimal?    @map("delivery_lng") @db.Decimal(10, 7)
  subtotal         Decimal     @default(0) @db.Decimal(15, 2) // ยอดขายรวม
  totalCost        Decimal     @default(0) @map("total_cost") @db.Decimal(15, 2) // ต้นทุน+ขนส่ง
  totalProfit      Decimal     @default(0) @map("total_profit") @db.Decimal(15, 2)
  creditOverride   Boolean     @default(false) @map("credit_override") // ขายเกินวงเงิน (อนุมัติแล้ว)
  notes            String?
  // TRCloud sync (ออก IV เข้า TRCloud ตอนยืนยันออเดอร์ · ลบตอนยกเลิก)
  trcloudIvId      String?     @map("trcloud_iv_id") // id ของ IV ในระบบ TRCloud (ใช้ลบ)
  trcloudIvNo      String?     @map("trcloud_iv_no") // เลขที่เอกสาร IV
  trcloudSyncedAt  DateTime?   @map("trcloud_synced_at")
  trcloudError     String?     @map("trcloud_error") // ถ้าออก IV ไม่สำเร็จ เก็บ error ไว้ retry
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  org      Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location DeliveryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sales    FuelUser          @relation("OrderSales", fields: [salesId], references: [id], onDelete: Restrict)
  truck    Truck?            @relation(fields: [truckId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  approval CreditApproval?

  @@unique([orgId, orderNo])
  @@index([orgId, status])
  @@index([customerId, scheduledDate])
  @@index([salesId, createdAt])
  @@index([truckId, scheduledDate])
  @@index([orgId, status, scheduledDate])
  @@map("orders")
  @@schema("fuel")
}

model OrderItem {
  id                String      @id @default(uuid()) @db.Uuid
  orderId           String      @map("order_id") @db.Uuid
  productType       ProductType @map("product_type")
  qtyLiters         Decimal     @map("qty_liters") @db.Decimal(12, 3)
  qtyDelivered      Decimal?    @map("qty_delivered") @db.Decimal(12, 3)
  pricePerLiter     Decimal     @map("price_per_liter") @db.Decimal(10, 4)
  costPerL          Decimal     @map("cost_per_l") @db.Decimal(10, 4)
  transportCostPerL Decimal     @default(0) @map("transport_cost_per_l") @db.Decimal(10, 4)
  marginPerLiter    Decimal     @map("margin_per_liter") @db.Decimal(10, 4)
  lineTotal         Decimal     @map("line_total") @db.Decimal(15, 2)
  lineProfit        Decimal     @map("line_profit") @db.Decimal(15, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
  @@schema("fuel")
}

model CreditApproval {
  id            String               @id @default(uuid()) @db.Uuid
  orgId         String               @map("org_id") @db.Uuid
  orderId       String               @unique @map("order_id") @db.Uuid
  requestedById String               @map("requested_by_id") @db.Uuid
  approvedById  String?              @map("approved_by_id") @db.Uuid
  status        CreditApprovalStatus @default(PENDING)
  amountOver    Decimal              @map("amount_over") @db.Decimal(15, 2)
  note          String?
  createdAt     DateTime             @default(now()) @map("created_at")
  actedAt       DateTime?            @map("acted_at")

  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy FuelUser  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  FuelUser? @relation("ApprovalActor", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@map("credit_approvals")
  @@schema("fuel")
}

// ---------- F9 Credit / payments / cheques ----------
model CreditDocument {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  docType    String    @map("doc_type") // contract | cert | id | statement | collateral
  fileKey    String?   @map("file_key")
  expiryDate DateTime? @map("expiry_date") @db.Date
  status     String    @default("pending") // valid | expired | missing | pending
  createdAt  DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("credit_documents")
  @@schema("fuel")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  orgId        String        @map("org_id") @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  orderId      String?       @map("order_id") @db.Uuid
  amount       Decimal       @db.Decimal(15, 2)
  method       PaymentMethod
  paymentDate  DateTime      @map("payment_date") @db.Date
  slipKey      String?       @map("slip_key") // รูปสลิปใน R2
  slipHash     String?       @map("slip_hash") // กันสลิปซ้ำ
  reference    String?
  status       PaymentStatus @default(PENDING) // รอการเงินยืนยันยอดเข้าจริง
  verifiedById String?       @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime?     @map("verified_at")
  notes        String?
  createdById  String?       @map("created_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  verifiedBy FuelUser? @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  cheques    Cheque[]

  @@unique([orgId, slipHash])
  @@index([orgId, status])
  @@index([customerId, paymentDate])
  @@map("payments")
  @@schema("fuel")
}

model Cheque {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  paymentId     String?      @map("payment_id") @db.Uuid
  chequeNumber  String       @map("cheque_number")
  bank          String
  amount        Decimal      @db.Decimal(15, 2)
  dueDate       DateTime     @map("due_date") @db.Date
  status        ChequeStatus @default(PENDING)
  clearedAt     DateTime?    @map("cleared_at")
  bouncedReason String?      @map("bounced_reason")
  createdAt     DateTime     @default(now()) @map("created_at")

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([orgId, dueDate])
  @@map("cheques")
  @@schema("fuel")
}

// ---------- F10 Dispatch + GPS ----------
model Truck {
  id              String      @id @default(uuid()) @db.Uuid
  orgId           String      @map("org_id") @db.Uuid
  plate           String // ทะเบียนรถ
  capacityLiters  Int         @map("capacity_liters")
  gpsUnitId       String?     @unique @map("gps_unit_id") // เลขกล่อง GPS (DLT unit_id)
  homeDepot       String?     @map("home_depot")
  status          TruckStatus @default(IDLE)
  currentDriverId String?     @map("current_driver_id") @db.Uuid
  // ตำแหน่งล่าสุด (denormalized เพื่อความเร็วหน้าแผนที่)
  lastLat         Decimal?    @map("last_lat") @db.Decimal(10, 7)
  lastLng         Decimal?    @map("last_lng") @db.Decimal(10, 7)
  lastSpeedKmh    Decimal?    @map("last_speed_kmh") @db.Decimal(5, 1)
  lastEngineOn    Boolean?    @map("last_engine_on")
  lastCourseDeg   Int?        @map("last_course_deg")
  lastSeenAt      DateTime?   @map("last_seen_at")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  org           Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  currentDriver FuelUser?       @relation("TruckDriver", fields: [currentDriverId], references: [id], onDelete: SetNull)
  orders        Order[]
  locations     TruckLocation[]

  @@index([orgId, isActive])
  @@index([orgId, status])
  @@map("trucks")
  @@schema("fuel")
}

model TruckLocation {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  truckId    String   @map("truck_id") @db.Uuid
  lat        Decimal  @db.Decimal(10, 7)
  lng        Decimal  @db.Decimal(10, 7)
  speedKmh   Decimal? @map("speed_kmh") @db.Decimal(5, 1)
  engineOn   Boolean? @map("engine_on")
  courseDeg  Int?     @map("course_deg")
  recordedAt DateTime @default(now()) @map("recorded_at")

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@index([truckId, recordedAt])
  @@map("truck_locations")
  @@schema("fuel")
}

// ---------- F4 bot assist + bank accounts ----------
model BotFaq {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  keywords  String // comma-separated
  answer    String
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  hits      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, enabled])
  @@map("bot_faqs")
  @@schema("fuel")
}

model BankAccount {
  id          String  @id @default(uuid()) @db.Uuid
  orgId       String  @map("org_id") @db.Uuid
  bankName    String  @map("bank_name")
  accountName String  @map("account_name")
  accountNo   String  @map("account_no")
  isDefault   Boolean @default(false) @map("is_default")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
  @@schema("fuel")
}

// ---------- F5 follow-ups ----------
model FollowUp {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  customerId String?        @map("customer_id") @db.Uuid
  salesId    String         @map("sales_id") @db.Uuid
  dueDate    DateTime       @map("due_date") @db.Date
  note       String
  status     FollowUpStatus @default(OPEN)
  kind       String         @default("manual") // manual | overdue | prospect
  createdAt  DateTime       @default(now()) @map("created_at")

  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sales    FuelUser  @relation("FollowUpSales", fields: [salesId], references: [id], onDelete: Cascade)

  @@index([orgId, status, dueDate])
  @@index([salesId, status])
  @@map("follow_ups")
  @@schema("fuel")
}

// ---------- audit ----------
model FuelAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  org  Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user FuelUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@map("audit_logs")
  @@schema("fuel")
}

// =============================================================
// LEDGER MODULE — LedgerLine (slug "ledger")
// ระบบบัญชี/ใบเสร็จ · capture → AI OCR → Recheck → human-confirm → store
// COMPLEMENT TRCloud (export INTO it; TRCloud = book of record)
// 3-tier tenancy: org_id + company_id + branch_id · RLS org_id = current_org_id()
// NEVER auto-post: expenses start status="draft" until accountant confirms.
// Spec: docs/BIGFEATURE_ledger_SPEC.md · plan docs/PLAN_ledger_module.md
// =============================================================
enum LedgerExpenseStatus {
  draft // อ่านด้วย AI แล้ว · รอคนยืนยัน (default — ห้าม auto-post)
  confirmed // บัญชียืนยันแล้ว
  locked // ปิดงวด/export แล้ว · แก้ไม่ได้
  void // ยกเลิก

  @@schema("public")
}

enum LedgerExpenseSource {
  line // มาจากกลุ่ม LINE (staff ถ่าย)
  web // อัปโหลดผ่านเว็บหลังบ้าน
  email // Gmail auto-ingest (Phase 2)

  @@schema("public")
}

// หมวดค่าใช้จ่าย — ผูกกับบริษัท (แต่ละบริษัทมีผังบัญชีของตัวเอง)
model LedgerCategory {
  id                 String   @id @default(uuid()) @db.Uuid
  orgId              String   @map("org_id") @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  name               String
  kind               String   @default("expense") // เผื่ออนาคต (รายรับ v2)
  color              String?
  trcloudAccCode     String?  @map("trcloud_acc_code")     // GL account code (e.g. 5220020)
  trcloudProductCode String?  @map("trcloud_product_code") // fixed SKU (JPS-100/101/103)
  vatClaimable       Boolean  @default(false) @map("vat_claimable") // true = ขอ VAT คืนได้ (ต้องตั้งใจ); false = default conservative
  sort               Int      @default(0)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses LedgerExpense[]
  budgets  LedgerBudget[]

  @@unique([orgId, companyId, name])
  @@index([orgId, companyId, active, sort])
  @@map("ledger_category")
  @@schema("public")
}

// ค่าใช้จ่าย (core) — 1 ใบเสร็จ/สลิป = 1 row
model LedgerExpense {
  id                    String              @id @default(uuid()) @db.Uuid
  orgId                 String              @map("org_id") @db.Uuid
  companyId             String              @map("company_id") @db.Uuid
  branchId              String?             @map("branch_id") @db.Uuid
  docCode               String              @map("doc_code") // EXP-YYYYMM-NNNN
  status                LedgerExpenseStatus @default(draft)
  source                LedgerExpenseSource @default(web)
  vendor                String?
  vendorTaxId           String?             @map("vendor_tax_id")
  docDate               DateTime?           @map("doc_date") @db.Date
  subtotal              Decimal             @default(0) @db.Decimal(15, 2)
  vat                   Decimal             @default(0) @db.Decimal(15, 2)
  wht                   Decimal             @default(0) @db.Decimal(15, 2) // หัก ณ ที่จ่าย
  total                 Decimal             @default(0) @db.Decimal(15, 2)
  categoryId            String?             @map("category_id") @db.Uuid
  paymentMethod         String?             @map("payment_method")
  originalUrl           String?             @map("original_url") // Drive (P1.5) / R2
  thumbUrl              String?             @map("thumb_url") // R2
  driveFileId           String?             @map("drive_file_id") // Google Drive file id (receipt original)
  driveWebUrl           String?             @map("drive_web_url") // shareable Drive link for the accountant
  branchTagPending      Boolean             @default(false) @map("branch_tag_pending") // central group: branch not yet chosen
  sha256                String? // dedup
  ocrModel              String?             @map("ocr_model")
  ocrConfidence         Json?               @map("ocr_confidence") // { vendor: 0.9, total: 0.95, ... }
  slipRef               String?             @map("slip_ref") // SlipOK ref (Phase 2)
  lineConfirmMessageId  String?             @map("line_confirm_message_id") // LINE confirm-card messageId → reply-to-bill match
  lineMessageId         String?             @map("line_message_id") // LINE original message id (first image/file message that created this expense)
  needsReview           Boolean             @default(true) @map("needs_review")
  note                  String?
  // — Bainy-parity edit-form fields (Phase 3) —
  docType               String              @default("tax_invoice") @map("doc_type") // ใบกำกับภาษี/ใบเสร็จ/บิลเงินสด/ใบส่งของ/อื่นๆ
  vendorDocNumber       String?             @map("vendor_doc_number") // เลขที่เอกสารของผู้ขาย (≠ doc_code ภายใน)
  vendorAddress         String?             @map("vendor_address")
  vendorBranchCode      String?             @map("vendor_branch_code")
  discount              Decimal             @default(0) @db.Decimal(15, 2) // ส่วนลด
  paymentStatus         String              @default("paid") @map("payment_status") // paid | unpaid | partial
  claimantName          String?             @map("claimant_name") // ผู้เบิก
  bankDetail            String?             @map("bank_detail")
  isRecurring           Boolean             @default(false) @map("is_recurring") // รายจ่ายประจำ
  attachments           Json? // [{url,kind:'po'|'evidence',name}] PO + หลักฐานเพิ่มเติม
  captureBatchId        String?             @map("capture_batch_id") @db.Uuid // groups receipts sent together
  createdBy             String?             @map("created_by") @db.Uuid
  confirmedBy           String?             @map("confirmed_by") @db.Uuid
  confirmedAt           DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  exportBatchId         String?             @map("export_batch_id") @db.Uuid
  // — TRCloud API push (ใบ AP เข้า TRCloud) — stamped once on a successful push so
  //   the expense can never be double-pushed; trcloudError holds the last failure. —
  trcloudDocId          String?             @map("trcloud_doc_id") // id ของ AP ในระบบ TRCloud
  trcloudDocNo          String?             @map("trcloud_doc_no") // เลขที่เอกสาร AP
  trcloudPushedAt       DateTime?           @map("trcloud_pushed_at") @db.Timestamptz(6)
  trcloudError          String?             @map("trcloud_error")
  // ประเภทการซื้อที่ AI อ่านจากบิล → ใช้เลือก SKU อัตโนมัติตอน push (goods=JPS-100 /
  // service=JPS-101 / construction=JPS-103). null = ให้ push เดาจากชื่อประเภทค่าใช้จ่าย.
  trcloudPurchaseType   String?             @map("trcloud_purchase_type")
  // — Inventory STOCK-IN (รับเข้าสต๊อก, LEDGER_STOCKIN_V1) — แยกจาก AP-expense push.
  trcloudStockinDocId   String?             @map("trcloud_stockin_doc_id")
  trcloudStockinNo      String?             @map("trcloud_stockin_no")
  trcloudStockinAt      DateTime?           @map("trcloud_stockin_at") @db.Timestamptz(6)
  trcloudStockinError   String?             @map("trcloud_stockin_error")
  // — Input-VAT claimability (ภาษีซื้อ) — ตัดสินด้วยเลขภาษี 13 หลักเป๊ะ (ไม่เดาชื่อ).
  //   buyer = ผู้ซื้อ (เจพีซิ้งค์); สถานะสี = deterministic จาก recheck.ts; never-auto-post.
  buyerTaxIdSnapshot    String?             @map("buyer_tax_id_snapshot") // เลขภาษีผู้ซื้อ ณ เวลาบันทึก จาก master (ไม่ใช่ OCR)
  buyerNameSnapshot     String?             @map("buyer_name_snapshot") // ชื่อผู้ซื้อจาก master
  buyerTaxIdOnDoc       String?             @map("buyer_tax_id_on_doc") // OCR เจอบนใบ — เพื่อ audit/verify
  buyerMatchStatus      String              @default("undecided") @map("buyer_match_status") // matched | mismatch | not_found_on_doc | undecided
  completenessStatus    String              @default("undecided") @map("completeness_status") // green_full | yellow_partial | red_invalid | undecided
  completenessMissing   Json?               @map("completeness_missing") // string[] — element ที่ขาด
  completenessCheckedAt DateTime?           @map("completeness_checked_at") @db.Timestamptz(6) // snapshot audit
  inputVatClaimable     Boolean?            @map("input_vat_claimable") // null = ยังไม่ตัดสิน
  inputVatBlockReason   String?             @map("input_vat_block_reason") // abbreviated_86_6 | buyer_mismatch | wrong_entity | incomplete_invoice | entertainment | passenger_car | other
  replacementOfId       String?             @map("replacement_of_id") @db.Uuid // ใบนี้เป็นใบทดแทนของใบเดิม
  replacedById          String?             @map("replaced_by_id") @db.Uuid // ใบนี้ถูกทดแทนโดยใบใหม่
  overrideBy            String?             @map("override_by") @db.Uuid
  overrideAt            DateTime?           @map("override_at") @db.Timestamptz(6)
  overrideReason        String?             @map("override_reason")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category      LedgerCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exportBatch   LedgerExportBatch?  @relation(fields: [exportBatchId], references: [id], onDelete: SetNull)
  items         LedgerExpenseItem[]
  // Replacement chain (แนบใบใหม่ทดแทน — เก็บทั้ง 2 ใบ): self-relation.
  replacementOf LedgerExpense?      @relation("ExpenseReplacement", fields: [replacementOfId], references: [id], onDelete: SetNull)
  replacedBy    LedgerExpense[]     @relation("ExpenseReplacement")
  payments      LedgerPayment[]     @relation("ExpensePayments")

  @@unique([orgId, companyId, docCode])
  @@index([orgId, companyId, branchId, status])
  @@index([orgId, companyId, status, docDate(sort: Desc)])
  @@index([orgId, companyId, categoryId])
  @@index([sha256]) // dedup lookup
  @@index([exportBatchId])
  @@index([captureBatchId])
  @@index([replacementOfId])
  @@index([orgId, companyId, completenessStatus])
  @@index([orgId, companyId, trcloudDocId]) // "not-yet-pushed confirmed" filter in listExpenses
  @@index([orgId, companyId, createdAt(sort: Desc)]) // list by newest across company
  @@index([orgId, companyId, paymentStatus]) // payment status filter
  @@map("ledger_expense")
  @@schema("public")
}

// หลักฐานการจ่ายเงิน (สลิปโอน) — 1 bill : N payments (N เผื่อ partial/split v2).
// กันจ่ายซ้ำด้วย (sendingBank, transRef) จาก QR สลิป (ถอดเองฟรี). never-auto-post.
model LedgerPayment {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  matchedExpenseId  String?   @map("matched_expense_id") @db.Uuid
  paymentRequestId  String?   @map("payment_request_id") @db.Uuid // ขอโอนเงิน: สลิปนี้จ่ายตามคำขอไหน
  amount            Decimal   @default(0) @db.Decimal(15, 2)
  currency          String    @default("THB")
  method            String    @default("transfer") // transfer | cash | qr
  sendingBank       String?   @map("sending_bank")
  transRef          String?   @map("trans_ref") // EMVCo slip-QR ref — dup key
  slipSha256        String?   @map("slip_sha256")
  slipUrl           String?   @map("slip_url")
  slipThumbUrl      String?   @map("slip_thumb_url")
  qrRaw             String?   @map("qr_raw")
  qrDecoded         Boolean   @default(false) @map("qr_decoded")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  markedBy          String?   @map("marked_by") @db.Uuid
  dupOverrideBy     String?   @map("dup_override_by") @db.Uuid
  dupOverrideReason String?   @map("dup_override_reason")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  matchedExpense LedgerExpense?         @relation("ExpensePayments", fields: [matchedExpenseId], references: [id], onDelete: SetNull)
  paymentRequest LedgerPaymentRequest? @relation("RequestPayments", fields: [paymentRequestId], references: [id], onDelete: SetNull)

  @@index([orgId, companyId, matchedExpenseId])
  @@index([orgId, companyId, paymentRequestId])
  @@index([slipSha256])
  // NOTE: a PARTIAL unique on (orgId, companyId, transRef) WHERE transRef IS NOT NULL is enforced
  // at the DB level via migration SQL. Prisma 5 cannot express partial indexes; rely on the SQL
  // migration + P2002 handling in server actions. The index below is non-unique for query perf.
  @@index([orgId, companyId, transRef])
  @@map("ledger_payment")
  @@schema("public")
}

// คำขอโอนเงิน (ขอโอนเงิน) — operation เลือกบิล 1+ ใบ → ขอโอน → การ์ดเด้งกลุ่มผู้บริหาร
// → ผู้บริหารโอน+ส่งสลิป → จับคู่ "สลิป ↔ คำขอ" (ไม่เดายอด) → ปิดทุกบิลในคำขอ.
// 3 ยอด snapshot (gross/wht/expected) freeze ณ เวลาขอ; จับคู่สลิปกับ expected (net-of-WHT).
model LedgerPaymentRequest {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  vendor          String?
  // payee snapshot (D4) — frozen ณ เวลาขอ (immutable evidence)
  payeeAcctName   String?   @map("payee_acct_name")
  payeeBankCode   String?   @map("payee_bank_code")
  payeeAcctNo     String?   @map("payee_acct_no")
  payeePromptpay  String?   @map("payee_promptpay")
  payeeQrPayload  String?   @map("payee_qr_payload")
  payeeQrImageUrl String?   @map("payee_qr_image_url") // uploaded QR image (R2) — scan from card

  billsGross      Decimal   @default(0) @map("bills_gross") @db.Decimal(15, 2)
  whtTotal        Decimal   @default(0) @map("wht_total") @db.Decimal(15, 2)
  expectedTransfer Decimal  @default(0) @map("expected_transfer") @db.Decimal(15, 2) // gross - wht
  paidTotal       Decimal   @default(0) @map("paid_total") @db.Decimal(15, 2)        // Σ matched slips
  state           String    @default("open") // open|partial|paid|cancelled|abnormal|reversed
  abnormalReason  String?   @map("abnormal_reason")
  requestedBy     String?   @map("requested_by") @db.Uuid
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  pushedGroupId   String?   @map("pushed_group_id")
  pushedMessageId String?   @map("pushed_message_id")
  paidBy          String?   @map("paid_by")           // LINE userId of payer (from slip)
  slipUploadedBy  String?   @map("slip_uploaded_by") @db.Uuid
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  bills    LedgerPaymentRequestBill[]
  payments LedgerPayment[]            @relation("RequestPayments")

  @@index([orgId, companyId, state])
  @@index([orgId, companyId, requestedAt(sort: Desc)])
  @@map("ledger_payment_request")
  @@schema("public")
}

// 1 คำขอ : N บิล (D3 รวมจ่าย). `active=false` เมื่อคำขอปิด/ยกเลิก → ปลดบิลให้ขอใหม่ได้.
// partial-unique (org,company,expense_id) WHERE active = กัน 1 บิลอยู่ 2 คำขอ active (กันจ่ายซ้ำ).
model LedgerPaymentRequestBill {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  expenseId  String   @map("expense_id") @db.Uuid
  billAmount Decimal  @default(0) @map("bill_amount") @db.Decimal(15, 2)
  billWht    Decimal  @default(0) @map("bill_wht") @db.Decimal(15, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request LedgerPaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([orgId, companyId, requestId])
  @@index([orgId, companyId, expenseId])
  @@map("ledger_payment_request_bill")
  @@schema("public")
}

// Debounced multi-image buffer: a burst of receipt photos (album) lands as
// separate webhook events → grouped here → ONE LINE carousel after ~3s quiet.
model LedgerCaptureBatch {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  channelRowId String    @map("channel_row_id") @db.Uuid
  groupKey     String    @map("group_key") // groupId (group) or userId (1:1)
  sourceType   String    @default("group") @map("source_type") // 'group' | 'user'
  replyToken   String?   @map("reply_token") // freshest LINE replyToken
  status       String    @default("open") // 'open' | 'sent'
  count        Int       @default(0)
  lastEventAt  DateTime  @default(now()) @map("last_event_at") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([channelRowId, groupKey, status, lastEventAt])
  @@map("ledger_capture_batch")
  @@schema("public")
}

// รายการย่อยในใบเสร็จ
model LedgerExpenseItem {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  expenseId   String   @map("expense_id") @db.Uuid
  description String
  qty         Decimal  @default(1) @db.Decimal(15, 3)
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(15, 2)
  amount      Decimal  @default(0) @db.Decimal(15, 2)
  vatRate     Decimal? @map("vat_rate") @db.Decimal(6, 4) // 0.07 = 7%
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expense LedgerExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([orgId, companyId])
  @@map("ledger_expense_item")
  @@schema("public")
}

// งบประมาณรายหมวด (รายเดือน) + เตือนเมื่อใกล้เกิน
model LedgerBudget {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  branchId   String?  @map("branch_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  period     String // "YYYY-MM" · หรือ "recurring" สำหรับงบประจำทุกเดือน
  recurring  Boolean  @default(false) // true = งบเดิมทุกเดือน
  amount     Decimal  @default(0) @db.Decimal(15, 2)
  alertPct   Int      @default(90) @map("alert_pct") // เตือนเมื่อใช้ถึง %
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category LedgerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([orgId, companyId, branchId, categoryId, period])
  @@index([orgId, companyId, period])
  @@map("ledger_budget")
  @@schema("public")
}

// เชื่อม Gmail การเงิน (ดึงค่าใช้จ่ายจากอีเมล แบบ Paypers) — รองรับหลายตู้เมล/บริษัท
// (D1: ตารางใหม่ของ LedgerLine เอง · ไม่ reuse ChairopsGmailConnection ที่เป็น org-only)
// refresh token เข้ารหัส AES-256-GCM (กุญแจเดียวกับ Drive/ChairOps Gmail) · scope readonly
model LedgerEmailConnection {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  gmailEmail        String    @map("gmail_email") // ตู้เมลที่เชื่อม (เป็น unique key ต่อบริษัท)
  refreshTokenEnc   String    @map("refresh_token_enc") // AES-256-GCM "iv:cipher:tag"
  scopes            String?
  connectedById     String?   @map("connected_by_id") @db.Uuid
  filterSenders     String[]  @default([]) @map("filter_senders") // allow-list ผู้ส่ง (OR logic)
  suppressedSenders String[]  @default([]) @map("suppressed_senders") // block-list → ตัดออก
  gmailLabel        String?   @map("gmail_label") // Gmail label name filter (NULL = ไม่กรอง)
  filterKeywords    String[]  @default([]) @map("filter_keywords") // subject keyword filter (OR)
  lastSyncAt        DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastSyncStatus    String?   @map("last_sync_status") // "ok" | "error: <msg>"
  lastSyncCount     Int       @default(0) @map("last_sync_count")
  firstScanDone     Boolean   @default(false) @map("first_scan_done") // กัน backfill 30 วันซ้ำ
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages LedgerEmailMessage[]

  @@unique([orgId, companyId, gmailEmail])
  @@index([orgId, companyId, active])
  @@map("ledger_email_connection")
  @@schema("public")
}

// ประวัติเมลที่สแกนแล้ว — กันซ้ำ (ก่อนเรียก AI) + audit trail + suppress-list driver
// + run summary. 1 แถว/อีเมลที่เจอ. unique(connection, gmailMessageId) = สแกนซ้ำไม่อ่าน AI ซ้ำ
model LedgerEmailMessage {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  gmailMessageId String    @map("gmail_message_id")
  status         String    @default("imported") // imported | needs_manual | skipped | error
  senderEmail    String?   @map("sender_email")
  subject        String?
  receivedAt     DateTime? @map("received_at") @db.Timestamptz(6)
  scanRunId      String?   @map("scan_run_id")
  expenseId      String?   @map("expense_id") @db.Uuid // ใบร่างที่สร้าง (ถ้าสร้าง)
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  connection LedgerEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, gmailMessageId])
  @@index([orgId, companyId])
  @@map("ledger_email_message")
  @@schema("public")
}

// ผูกกลุ่ม LINE (รับรูปใบเสร็จจากหน้างาน) — secrets เข้ารหัส (stub Phase 1)
model LedgerLineChannel {
  id                   String   @id @default(uuid()) @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  lineChannelId        String   @map("line_channel_id")
  webhookSecretEnc     String?  @map("webhook_secret_enc") // TODO[ledger-secret]
  accessTokenEnc       String?  @map("access_token_enc") // TODO[ledger-secret]
  groupId              String?  @map("group_id")
  branchId             String?  @map("branch_id") @db.Uuid // group = THIS branch (null = central)
  kind                 String   @default("central") // 'branch' | 'central' | 'dm'
  defaultPaymentMethod String?  @map("default_payment_method")
  defaultCategoryId    String?  @map("default_category_id") @db.Uuid
  richMenuId           String?  @map("rich_menu_id")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([orgId, lineChannelId])
  @@index([orgId, companyId, active])
  @@index([lineChannelId])
  @@map("ledger_line_channel")
  @@schema("public")
}

// หลายกลุ่ม LINE → หลายสาขา (B3): one OA serves many branch groups, each group
// pinned to its OWN branch. The webhook resolves the incoming group → branch here;
// when there's NO row for a group it falls back to ledger_line_channel.branchId
// (so single-group setups behave exactly as before). Relationless (matches
// LedgerLineMember) to keep the migration additive + low-risk on the live DB.
model LedgerLineGroup {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  groupId   String   @map("group_id") // LINE group id (C...)
  branchId  String?  @map("branch_id") @db.Uuid // this group → this branch
  label     String? // the real LINE group name (fetched via the group/summary API)
  memberCount Int?   @map("member_count") // snapshot of LINE group member count
  active    Boolean  @default(true)
  // PR4/D4 — true = กลุ่มส่งสลิป (รูป = สลิปจ่ายเงิน ไม่ใช่ใบเสร็จ).
  isSlipIntake Boolean @default(false) @map("is_slip_intake")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, companyId, groupId])
  @@index([orgId, companyId, active])
  @@map("ledger_line_group")
  @@schema("public")
}

// "เซฟเล่ม" — a saved filter set for the /ledger/ledger-book analytics view
// (LEDGER_ANALYTICS_V1). Shared per company (everyone in the company sees the
// same shelf). Stores the FILTER set, not a number snapshot → reopening recomputes
// live from real receipts. config = { axis, categoryId, branchId, grain, basis, q }.
model LedgerSavedBook {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  config    Json
  createdBy String?  @map("created_by") @db.Uuid
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orgId, companyId])
  @@map("ledger_saved_book")
  @@schema("public")
}

// ใครส่งใบเสร็จผ่าน LINE ได้ + ขอบเขต (สาขา/หมวดที่ดูแล) — จากลิงก์เชิญ
model LedgerLineMember {
  id                   String   @id @default(uuid()) @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  lineUserId           String   @map("line_user_id") // verified LINE userId
  poolUserId           String?  @map("pool_user_id") @db.Uuid
  displayName          String?  @map("display_name")
  role                 String   @default("staff") // staff | admin | accountant
  scopeBranchIds       String[] @map("scope_branch_ids") @db.Uuid
  scopeCategoryIds     String[] @map("scope_category_ids") @db.Uuid
  pendingBranchId      String?  @map("pending_branch_id") @db.Uuid // สาขาที่สมาชิกขอ (รออนุมัติ)
  defaultPaymentMethod String?  @map("default_payment_method")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, lineUserId])
  @@index([orgId, companyId, active])
  @@map("ledger_line_member")
  @@schema("public")
}

// สิทธิ์เรื่องเงินต่อ role (LIFF admin "สิทธิ์" tab) — เก็บเฉพาะ override; ไม่มีแถว = ใช้ default ในโค้ด
model LedgerPermission {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  role       String // staff | accountant | admin | external_accountant
  capability String // expense.confirm | expense.export | report.view_pnl | scope.all_branches | expense.edit_others
  allowed    Boolean
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?  @map("updated_by") @db.Uuid

  @@unique([orgId, role, capability])
  @@index([orgId])
  @@map("ledger_permission")
  @@schema("public")
}

// ลิงก์เชิญแบบมีขอบเขต (ดูแลสาขา/หมวดไหน)
model LedgerLineInvite {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  token            String    @unique
  role             String    @default("staff")
  scopeBranchIds   String[]  @map("scope_branch_ids") @db.Uuid
  scopeCategoryIds String[]  @map("scope_category_ids") @db.Uuid
  note             String?
  // Top-down binding (D-identity 2026-06-05): when set, accepting this invite ALSO
  // binds the accepter's verified Login `sub` to THIS Pool user (users.line_login_sub)
  // and links the ledger member → that Pool user. `kind='admin_claim'` = grant ledger
  // admin to that Pool user (used by promoteMemberToAdmin + the owner self-claim link).
  targetPoolUserId String?   @map("target_pool_user_id") @db.Uuid
  kind             String    @default("member") // member | admin_claim
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  usedByLineUserId String?   @map("used_by_line_user_id")
  usedAt           DateTime? @map("used_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, companyId])
  @@map("ledger_line_invite")
  @@schema("public")
}

// งวด export เข้า TRCloud (CSV/API)
model LedgerExportBatch {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  period     String // "YYYY-MM"
  format     String    @default("csv") // csv | trcloud_api
  status     String    @default("pending") // pending | done | failed
  rows       Int       @default(0)
  exportedAt DateTime? @map("exported_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses LedgerExpense[]

  @@index([orgId, companyId, period])
  @@map("ledger_export_batch")
  @@schema("public")
}

// TRCloud vendor map — tax_id → TRCloud contact_id (search-before-create dedup so a
// supplier is created in TRCloud ONCE and reused). taxId "" = the shared
// "เจ้าหนี้เบ็ดเตล็ด" bucket for cash/no-tax-id receipts. org/company scoped in app + RLS.
model LedgerTrcloudContact {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  taxId      String   @default("") @map("tax_id")
  contactId  String   @map("contact_id") // TRCloud system contact id
  codeNumber String?  @map("code_number") // TRCloud contact code/title (e.g. S260001) — AP customer block needs it
  name       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, companyId, taxId])
  @@map("ledger_trcloud_contact")
  @@schema("public")
}

// TRCloud product map — normalized line name → TRCloud product_id/SKU (dedup so the
// same item never spawns a second SKU). org/company scoped in app + RLS.
model LedgerTrcloudProduct {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  nameKey     String   @map("name_key")
  productId   String   @map("product_id") // TRCloud SKU code
  productName String?  @map("product_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, companyId, nameKey])
  @@map("ledger_trcloud_product")
  @@schema("public")
}

// Cache ของ SKU จาก TRCloud (mirror inventory/search ต่อธุรกิจ) — สำหรับ stock-IN.
// ไม่สร้าง SKU เอง · stock_tracked = admin เลือกว่าตัวไหนรับเข้าสต๊อก (LEDGER_STOCKIN_V1).
model LedgerTrcloudSku {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  productId     String   @map("product_id") // TRCloud SKU code (OIL_G95/LUB-0004/H_S0001)
  productName   String?  @map("product_name")
  businessGroup String?  @map("business_group") // TRCloud category field (business-line)
  unit          String?
  packFactor    Decimal  @default(1) @map("pack_factor") @db.Decimal(15, 4) // legacy default; 1 ลัง = N ขวด
  packUnits     Json     @default("[]") @map("pack_units") // [{name,factor}] หลายหน่วยซื้อ เช่น โหล=12, ลัง=24
  stockTracked  Boolean  @default(false) @map("stock_tracked")
  status        String?
  balanceCached Decimal? @map("balance_cached") @db.Decimal(15, 4)
  costCached    Decimal? @map("cost_cached") @db.Decimal(15, 4)
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  aliases     LedgerSkuAlias[]
  branchLinks LedgerSkuBranch[]

  @@unique([orgId, companyId, productId])
  @@index([orgId, companyId, businessGroup, stockTracked])
  @@map("ledger_trcloud_sku")
  @@schema("public")
}

// ผูก SKU กับสาขาที่ใช้จริง. ว่าง=ทุกสาขา · มีรายการ=รับเข้าจากสาขานอกรายการ=flag.
model LedgerSkuBranch {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sku    LedgerTrcloudSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([skuId, branchId])
  @@index([orgId, companyId, branchId])
  @@index([skuId])
  @@map("ledger_sku_branch")
  @@schema("public")
}

// จับคู่ชื่อสินค้าบนใบเสร็จ → SKU. exact จำได้ · ครั้งแรก admin map · ไม่เจอ=flag.
model LedgerSkuAlias {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  aliasKey  String   @map("alias_key") // normalized receipt text
  source    String   @default("admin") // admin | auto
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sku LedgerTrcloudSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([orgId, companyId, aliasKey])
  @@index([orgId, companyId, skuId])
  @@map("ledger_sku_alias")
  @@schema("public")
}

// =============================================================
// RentSpace — ระบบบริหารโครงการร้านค้าเช่า (commercial plaza rental)
// module slug `rentspace` · pilot โครงการทะเลทาวน์
// =============================================================

enum RentalUnitStatus {
  vacant // ว่าง
  occupied // มีผู้เช่า
  reserved // จอง
  inactive // ปิดใช้งาน

  @@schema("public")
}

enum RentalContractStatus {
  draft // ร่าง
  active // ใช้งาน
  expiring // ใกล้หมดอายุ
  expired // หมดอายุ
  terminated // ยกเลิก

  @@schema("public")
}

enum RentalBillStatus {
  draft
  issued // ออกบิลแล้ว
  partial // จ่ายบางส่วน
  paid // จ่ายครบ
  overdue // เกินกำหนด
  void // ยกเลิก

  @@schema("public")
}

enum RentalMeterKind {
  electric // ไฟ
  water // น้ำ

  @@schema("public")
}

enum RentalDepositKind {
  collect // เก็บ
  refund // คืน
  deduct // หัก
  forfeit // ริบ

  @@schema("public")
}

enum RentalDiscountStatus {
  pending
  approved
  rejected

  @@schema("public")
}

enum RentalLateFeeType {
  none
  fixed // คงที่ต่อครั้ง
  percent_total // % ของยอดบิล
  per_day // ต่อวันที่เกิน

  @@schema("public")
}

enum RentalDiscountKind {
  amount // จำนวนเงิน
  percent // เปอร์เซ็นต์

  @@schema("public")
}

model RentalProject {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  companyId        String?           @map("company_id") @db.Uuid
  name             String
  slug             String
  address          String?
  description      String?
  planImageUrl     String?           @map("plan_image_url")
  view3dEnabled    Boolean           @default(true) @map("view_3d_enabled")
  electricRate     Decimal           @default(7) @map("electric_rate") @db.Decimal(10, 2)
  waterRate        Decimal           @default(18) @map("water_rate") @db.Decimal(10, 2)
  vatPercent       Decimal           @default(0) @map("vat_percent") @db.Decimal(5, 2)
  lateFeeType      RentalLateFeeType @default(none) @map("late_fee_type")
  lateFeeValue     Decimal           @default(0) @map("late_fee_value") @db.Decimal(15, 2)
  lateFeeGraceDays Int               @default(7) @map("late_fee_grace_days")
  billDueDay       Int               @default(5) @map("bill_due_day")
  billCompanyName  String?           @map("bill_company_name")
  billTaxId        String?           @map("bill_tax_id")
  billBranch       String?           @map("bill_branch")
  billAddress      String?           @map("bill_address")
  autoBillEnabled  Boolean           @default(true) @map("auto_bill_enabled")
  billEditUnlocked Boolean           @default(false) @map("bill_edit_unlocked")
  billDeleteUnlocked Boolean         @default(false) @map("bill_delete_unlocked")
  billIssueUnlocked Boolean          @default(true) @map("bill_issue_unlocked")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  units     RentalUnit[]
  contracts RentalContract[]
  bills     RentalBill[]
  buildings RentalBuilding[]

  @@unique([orgId, slug])
  @@index([orgId, isActive])
  @@map("rental_project")
  @@schema("public")
}

model RentalUnit {
  id          String           @id @default(uuid()) @db.Uuid
  orgId       String           @map("org_id") @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  code        String // A1 · A2/1
  name        String? // SHABU ZEED
  building    String? // A1 / A2 / A3 (ชื่ออาคารแบบข้อความ — sync กับ buildingRef.name)
  buildingId  String?          @map("building_id") @db.Uuid
  floor       Int?
  zone        String?
  areaSqm     Decimal?         @map("area_sqm") @db.Decimal(10, 2)
  baseRentThb Decimal          @default(0) @map("base_rent_thb") @db.Decimal(15, 2)
  status      RentalUnitStatus @default(vacant)
  mapX        Decimal?         @map("map_x") @db.Decimal(7, 3)
  mapY        Decimal?         @map("map_y") @db.Decimal(7, 3)
  mapW        Decimal?         @map("map_w") @db.Decimal(7, 3)
  mapH        Decimal?         @map("map_h") @db.Decimal(7, 3)
  mapColor    String?          @map("map_color")
  sortOrder   Int              @default(0) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  project     RentalProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingRef RentalBuilding?      @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  contracts   RentalContract[]
  meters      RentalMeter[]
  readings    RentalMeterReading[]
  bills       RentalBill[]

  @@unique([projectId, code])
  @@index([orgId, projectId, status])
  @@index([buildingId])
  @@map("rental_unit")
  @@schema("public")
}

model RentalBuilding {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  zone      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project RentalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   RentalUnit[]

  @@index([orgId, projectId, sortOrder])
  @@map("rental_building")
  @@schema("public")
}

model RentalTenant {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  prefix      String? // นาย/นาง/บริษัท
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  nickname    String?
  bizName     String?   @map("biz_name") // ชื่อร้าน/กิจการ
  phones      String[]  @default([])
  idCardNo    String?   @map("id_card_no")
  taxId       String?   @map("tax_id")
  birthDate   DateTime? @map("birth_date") @db.Date
  nationality String?
  address     String?
  email       String?
  facebook    String?
  lineId      String?   @map("line_id")
  idCardUrl   String?   @map("id_card_url")
  docUrls     String[]  @default([]) @map("doc_urls")
  note        String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contracts RentalContract[]
  bills     RentalBill[]

  @@index([orgId, isActive])
  @@map("rental_tenant")
  @@schema("public")
}

model RentalContractTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  bodyHtml  String   @map("body_html") @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contracts RentalContract[]

  @@index([orgId, isActive])
  @@map("rental_contract_template")
  @@schema("public")
}

model RentalContract {
  id               String                  @id @default(uuid()) @db.Uuid
  orgId            String                  @map("org_id") @db.Uuid
  projectId        String                  @map("project_id") @db.Uuid
  unitId           String                  @map("unit_id") @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  templateId       String?                 @map("template_id") @db.Uuid
  contractNo       String                  @map("contract_no")
  startDate        DateTime                @map("start_date") @db.Date
  endDate          DateTime?               @map("end_date") @db.Date
  rentAmountThb    Decimal                 @default(0) @map("rent_amount_thb") @db.Decimal(15, 2)
  rentDueDay       Int                     @default(5) @map("rent_due_day")
  depositAmountThb Decimal                 @default(0) @map("deposit_amount_thb") @db.Decimal(15, 2)
  depositMonths    Decimal                 @default(0) @map("deposit_months") @db.Decimal(5, 2)
  vatPercent       Decimal                 @default(0) @map("vat_percent") @db.Decimal(5, 2)
  electricRate     Decimal?                @map("electric_rate") @db.Decimal(10, 2)
  waterRate        Decimal?                @map("water_rate") @db.Decimal(10, 2)
  lateFeeType      RentalLateFeeType       @default(none) @map("late_fee_type")
  lateFeeValue     Decimal                 @default(0) @map("late_fee_value") @db.Decimal(15, 2)
  lateFeeGraceDays Int                     @default(7) @map("late_fee_grace_days")
  // ส่วนลดส่งเสริมการขาย (โปรโมชั่น) — ลดต่อเดือน × จำนวนเดือน เริ่มงวดไหน
  promoDiscountThb Decimal                 @default(0) @map("promo_discount_thb") @db.Decimal(15, 2)
  promoMonths      Int                     @default(0) @map("promo_months")
  promoStartPeriod String?                 @map("promo_start_period")
  // วันวางบิลเฉพาะสัญญานี้ (null = ใช้ค่ากลางของโครงการ) — แต่ละเจ้ารอบบิลไม่ตรงกันได้
  billIssueDay     Int?                    @map("bill_issue_day")
  // วันที่ย้ายออกจริง (ตั้งตอนยกเลิกสัญญา) — ใช้ทำประวัติผู้เช่า
  moveOutDate      DateTime?               @map("move_out_date") @db.Date
  rentSchedule     Json?                   @map("rent_schedule")
  customTermsHtml  String?                 @map("custom_terms_html") @db.Text
  status           RentalContractStatus    @default(draft)
  signToken        String?                 @map("sign_token")
  signedAt         DateTime?               @map("signed_at") @db.Timestamptz(6)
  tenantSigned     Boolean                 @default(false) @map("tenant_signed")
  signatureDataUrl String?                 @map("signature_data_url") @db.Text
  signerName       String?                 @map("signer_name")
  contractPdfUrl   String?                 @map("contract_pdf_url")
  note             String?
  createdBy        String?                 @map("created_by") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  project  RentalProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit     RentalUnit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant   RentalTenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template RentalContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deposits RentalDeposit[]
  bills    RentalBill[]

  @@unique([orgId, contractNo])
  @@unique([signToken])
  @@index([orgId, projectId, status])
