// ---------- 1. Branches ----------
model PlaylandBranch {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  companyId    String?  @map("company_id") @db.Uuid
  slug         String   @unique
  name         String
  address      String?
  phone        String?
  email        String?
  openingHours Json?    @map("opening_hours") // { mon: { open: "10:00", close: "21:00" }, ... }
  settings     Json? // { parentFee: 50, exitRequiresStaff: true, maxAgeAlone: 12, ... }
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  devices      PlaylandDevice[]
  members      PlaylandMember[]
  packages     PlaylandPackage[]
  products     PlaylandProduct[]
  sessions     PlaylandSession[]
  bookings     PlaylandBooking[]
  sales        PlaylandSale[]
  shifts       PlaylandShift[]
  promos       PlaylandPromo[]
  alerts       PlaylandAlert[]
  faceEvents     PlaylandFaceEvent[]
  familyGroups   PlaylandFamilyGroup[]
  dailyReports   PlaylandDailyReport[]
  stockMovements PlaylandStockMovement[]
  purchases      PlaylandPurchase[]
  repairLogs     PlaylandRepairLog[]

  @@index([orgId])
  @@map("branches")
  @@schema("playland")
}

// ---------- 2. ACS Devices (per branch) ----------
model PlaylandDevice {
  id              String               @id @default(uuid()) @db.Uuid
  orgId           String               @map("org_id") @db.Uuid
  branchId        String               @map("branch_id") @db.Uuid
  vendor          String               @default("acs-auto")
  model           String               @default("ACS-F606")
  deviceId        String               @unique @map("device_id")
  deviceName      String               @map("device_name")
  baseUrl         String?              @map("base_url") // for our → device calls (TCP/HTTP push)
  protocol        String               @default("http") // "http" | "tcp"
  modelVersion    String               @default("C") // "B" online-only | "C" mixed
  secretEncrypted String?              @map("secret_encrypted")
  webhookSecret   String?              @map("webhook_secret") // shared in URL query · since no HMAC support
  status          PlaylandDeviceStatus @default(PAIRING)
  lastSeenAt      DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  lastEventAt     DateTime?            @map("last_event_at") @db.Timestamptz(6)
  firmwareVersion String?              @map("firmware_version")
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch     PlaylandBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  faceEvents PlaylandFaceEvent[]
  faceSync   PlaylandFaceSync[]

  @@index([orgId, branchId])
  @@map("devices")
  @@schema("playland")
}

// ---------- 3. Family Group (พ่อ+แม่+ลูกๆ) ----------
model PlaylandFamilyGroup {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  displayName  String   @map("display_name") // "ครอบครัวคุณสมศักดิ์"
  primaryPhone String?  @map("primary_phone")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch  PlaylandBranch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  members PlaylandFamilyMember[]

  @@index([orgId, branchId])
  @@map("family_groups")
  @@schema("playland")
}

// ---------- 4. Family group join (many-to-many between members) ----------
model PlaylandFamilyMember {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  familyGroupId String   @map("family_group_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  role          String   @default("relative") // "primary_guardian" | "guardian" | "child" | "relative"
  canPickUp     Boolean  @default(true) @map("can_pick_up")
  addedAt       DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  familyGroup PlaylandFamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  member      PlaylandMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([familyGroupId, memberId])
  @@index([orgId])
  @@index([memberId])
  @@map("family_members")
  @@schema("playland")
}

// ---------- 5. Members (เด็ก/ผู้ปกครอง/พนักงาน/แม่บ้าน/VIP/babysitter/guest) ----------
model PlaylandMember {
  id               String             @id @default(uuid()) @db.Uuid
  orgId            String             @map("org_id") @db.Uuid
  branchId         String             @map("branch_id") @db.Uuid
  memberCode       String?            @unique @map("member_code") // PL-2569-NNNN
  type             PlaylandMemberType
  name             String
  nickname         String?
  phone            String?
  email            String?
  dateOfBirth      DateTime?          @map("date_of_birth") @db.Date
  gender           String? // "M" | "F" | "O"
  photoR2Path      String?            @map("photo_r2_path") // R2 key
  photoUrl         String?            @map("photo_url") // signed URL cache
  faceId           String?            @map("face_id") // ACS device face_id
  externalLineId   String?            @map("external_line_id")
  registeredById   String?            @map("registered_by_id") @db.Uuid // staff user
  consentAt        DateTime?          @map("consent_at") @db.Timestamptz(6)
  consentRevokedAt DateTime?          @map("consent_revoked_at") @db.Timestamptz(6)
  retentionUntil   DateTime?          @map("retention_until") @db.Timestamptz(6) // PDPA
  lastVisitAt      DateTime?          @map("last_visit_at") @db.Timestamptz(6)
  notes            String?
  metadata         Json? // birthday discount given? VIP perks?
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch            PlaylandBranch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  familyMemberships PlaylandFamilyMember[]
  sessions          PlaylandSession[]
  wristbands        PlaylandWristband[]
  bookings          PlaylandBooking[]
  waivers           PlaylandWaiver[]
  loyalty           PlaylandLoyalty?
  faceSync          PlaylandFaceSync[]
  faceEvents        PlaylandFaceEvent[]

  @@index([orgId, branchId])
  @@index([branchId, type])
  @@index([faceId])
  @@index([phone])
  @@map("members")
  @@schema("playland")
}

// ---------- 6. Packages ----------
model PlaylandPackage {
  id                 String              @id @default(uuid()) @db.Uuid
  orgId              String              @map("org_id") @db.Uuid
  branchId           String?             @map("branch_id") @db.Uuid // null = all branches
  type               PlaylandPackageType
  name               String
  description        String?
  minutes            Int? // null for DAY_PASS
  price              Int // satang (฿*100)
  perMinuteRate      Int?                @map("per_minute_rate") // satang/นาที for PER_MINUTE
  memberTypesAllowed Json?               @map("member_types_allowed") // ["KID", "VIP"] or null=all
  active             Boolean             @default(true)
  sortOrder          Int                 @default(0) @map("sort_order")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch   PlaylandBranch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions PlaylandSession[]
  bookings PlaylandBooking[]

  @@index([orgId, branchId])
  @@index([branchId, active, sortOrder])
  @@map("packages")
  @@schema("playland")
}

// ---------- 7. Sessions (เซสชั่นเล่น) ----------
model PlaylandSession {
  id                 String                @id @default(uuid()) @db.Uuid
  orgId              String                @map("org_id") @db.Uuid
  branchId           String                @map("branch_id") @db.Uuid
  memberId           String                @map("member_id") @db.Uuid
  packageId          String?               @map("package_id") @db.Uuid
  bookingId          String?               @map("booking_id") @db.Uuid
  packageMinutes     Int                   @map("package_minutes") // 0 = day pass
  packagePriceCents  Int                   @map("package_price_cents")
  minutesUsed        Int                   @default(0) @map("minutes_used")
  totalPausedSeconds Int                   @default(0) @map("total_paused_seconds")
  status             PlaylandSessionStatus @default(ACTIVE)
  checkInAt          DateTime              @default(now()) @map("check_in_at") @db.Timestamptz(6)
  pausedAt           DateTime?             @map("paused_at") @db.Timestamptz(6)
  resumedAt          DateTime?             @map("resumed_at") @db.Timestamptz(6)
  checkOutAt         DateTime?             @map("check_out_at") @db.Timestamptz(6)
  expiresAt          DateTime?             @map("expires_at") @db.Timestamptz(6)
  reentryDeadlineAt  DateTime?             @map("reentry_deadline_at") @db.Timestamptz(6)
  extendedCount      Int                   @default(0) @map("extended_count")
  cashierUserId      String?               @map("cashier_user_id") @db.Uuid
  closedByUserId     String?               @map("closed_by_user_id") @db.Uuid
  notes              String?
  metadata           Json?
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch     PlaylandBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member     PlaylandMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  package    PlaylandPackage?    @relation(fields: [packageId], references: [id])
  booking    PlaylandBooking?    @relation(fields: [bookingId], references: [id])
  faceEvents PlaylandFaceEvent[]
  alerts     PlaylandAlert[]
  sales      PlaylandSale[]
  wristbands PlaylandWristband[]

  @@index([orgId, branchId])
  @@index([branchId, status])
  @@index([memberId, checkInAt])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("playland")
}

// ---------- 8. Face Events (log จาก ACS device · idempotent via webhookId) ----------
model PlaylandFaceEvent {
  id             String                @id @default(uuid()) @db.Uuid
  orgId          String                @map("org_id") @db.Uuid
  branchId       String                @map("branch_id") @db.Uuid
  deviceId       String                @map("device_id") @db.Uuid
  sessionId      String?               @map("session_id") @db.Uuid
  memberId       String?               @map("member_id") @db.Uuid
  faceId         String?               @map("face_id")
  type           PlaylandFaceEventType
  direction      PlaylandFaceDirection @default(UNKNOWN)
  confidence     Int? // 0-100
  snapshotR2Path String?               @map("snapshot_r2_path")
  rawPayload     Json?                 @map("raw_payload")
  webhookId      String                @unique @map("webhook_id") // idempotency
  eventAt        DateTime              @map("event_at") @db.Timestamptz(6)
  receivedAt     DateTime              @default(now()) @map("received_at") @db.Timestamptz(6)

  branch  PlaylandBranch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  device  PlaylandDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  session PlaylandSession? @relation(fields: [sessionId], references: [id])
  member  PlaylandMember?  @relation(fields: [memberId], references: [id])

  @@index([orgId, branchId])
  @@index([branchId, eventAt])
  @@index([memberId, eventAt])
  @@index([type, eventAt])
  @@map("face_events")
  @@schema("playland")
}

// ---------- 9. Bookings (จองล่วงหน้า) ----------
model PlaylandBooking {
  id                String                 @id @default(uuid()) @db.Uuid
  orgId             String                 @map("org_id") @db.Uuid
  branchId          String                 @map("branch_id") @db.Uuid
  memberId          String?                @map("member_id") @db.Uuid
  packageId         String                 @map("package_id") @db.Uuid
  bookingCode       String                 @unique @map("booking_code") // PB-2569-NNNN
  customerName      String                 @map("customer_name")
  customerPhone     String                 @map("customer_phone")
  customerEmail     String?                @map("customer_email")
  partySize         Int                    @default(1) @map("party_size")
  slotStart         DateTime               @map("slot_start") @db.Timestamptz(6)
  slotEnd           DateTime               @map("slot_end") @db.Timestamptz(6)
  amountCents       Int                    @map("amount_cents")
  paymentMethod     PlaylandPaymentMethod? @map("payment_method")
  paymentRef        String?                @map("payment_ref") // Stripe session_id
  paymentStatus     String                 @default("pending") @map("payment_status")
  qrCodeUrl         String?                @map("qr_code_url")
  status            PlaylandBookingStatus  @default(PENDING)
  expiresAt         DateTime?              @map("expires_at") @db.Timestamptz(6)
  confirmedByUserId String?                @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?                @map("cancel_reason")
  notes             String?
  metadata          Json?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch   PlaylandBranch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  member   PlaylandMember?   @relation(fields: [memberId], references: [id])
  package  PlaylandPackage   @relation(fields: [packageId], references: [id])
  sessions PlaylandSession[]

  @@index([orgId, branchId])
  @@index([branchId, slotStart])
  @@index([status, expiresAt])
  @@index([customerPhone])
  @@map("bookings")
  @@schema("playland")
}

// ---------- 10. Products (POS) ----------
// kind: ขนม/น้ำขายผ่าน POS = SALE_ITEM · อะไหล่ซ่อมเครื่อง = SPARE_PART (เบิกใช้ในงานซ่อม)
enum PlaylandProductKind {
  SALE_ITEM
  SPARE_PART

  @@schema("playland")
}

// ทุกการเคลื่อนไหวสต๊อก (เข้า/ออก) = 1 แถวใน stock_movements → ตรวจย้อนหลังได้
enum PlaylandStockMoveKind {
  PURCHASE_IN
  SALE_OUT
  COUNT_ADJUST
  PART_USED
  RETURN_IN
  MANUAL_ADJUST

  @@schema("playland")
}

model PlaylandProduct {
  id           String              @id @default(uuid()) @db.Uuid
  orgId        String              @map("org_id") @db.Uuid
  branchId     String              @map("branch_id") @db.Uuid
  kind         PlaylandProductKind @default(SALE_ITEM)
  sku          String?
  barcode      String?
  category     String?
  name         String
  description  String?
  supplier     String?
  priceCents   Int                 @map("price_cents")
  costCents    Int?                @map("cost_cents")
  stock        Int                 @default(0)
  reorderLevel Int                 @default(0) @map("reorder_level")
  imageR2Path  String?             @map("image_r2_path")
  active       Boolean             @default(true)
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch        PlaylandBranch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  saleLines     PlaylandSaleLine[]
  movements     PlaylandStockMovement[]
  purchaseLines PlaylandPurchaseLine[]
  repairParts   PlaylandRepairPart[]

  @@unique([branchId, barcode])
  @@index([orgId, branchId])
  @@index([branchId, active, sortOrder])
  @@index([branchId, kind, active])
  @@map("products")
  @@schema("playland")
}

// ---------- 10b. Stock Movement Ledger (ทุกการเข้า-ออกของสต๊อก) ----------
model PlaylandStockMovement {
  id            String                @id @default(uuid()) @db.Uuid
  orgId         String                @map("org_id") @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  kind          PlaylandStockMoveKind
  quantity      Int
  unitCostCents Int?                  @map("unit_cost_cents")
  balanceAfter  Int?                  @map("balance_after")
  refType       String?               @map("ref_type")
  refId         String?               @map("ref_id") @db.Uuid
  note          String?
  actorUserId   String?               @map("actor_user_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  branch  PlaylandBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product PlaylandProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orgId, branchId])
  @@index([productId, createdAt])
  @@index([branchId, kind, createdAt])
  @@map("stock_movements")
  @@schema("playland")
}

// ---------- 10c. Purchases (รับของเข้า · goods receipt) ----------
model PlaylandPurchase {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  purchaseCode    String   @unique @map("purchase_code")
  supplierName    String?  @map("supplier_name")
  totalCostCents  Int      @default(0) @map("total_cost_cents")
  note            String?
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch PlaylandBranch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lines  PlaylandPurchaseLine[]

  @@index([orgId, branchId])
  @@index([branchId, createdAt])
  @@map("purchases")
  @@schema("playland")
}

model PlaylandPurchaseLine {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  purchaseId    String   @map("purchase_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productName   String   @map("product_name")
  quantity      Int
  unitCostCents Int      @map("unit_cost_cents")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchase PlaylandPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  PlaylandProduct  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_lines")
  @@schema("playland")
}

// ---------- 10d. Repair Logs (ซ่อมเครื่อง · เบิกอะไหล่) ----------
model PlaylandRepairLog {
  id              String               @id @default(uuid()) @db.Uuid
  orgId           String               @map("org_id") @db.Uuid
  branchId        String               @map("branch_id") @db.Uuid
  repairCode      String               @unique @map("repair_code")
  machineLabel    String               @map("machine_label")
  description     String?
  partsCostCents  Int                  @default(0) @map("parts_cost_cents")
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  branch PlaylandBranch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parts  PlaylandRepairPart[]

  @@index([orgId, branchId])
  @@index([branchId, createdAt])
  @@map("repair_logs")
  @@schema("playland")
}

model PlaylandRepairPart {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  repairId      String   @map("repair_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productName   String   @map("product_name")
  quantity      Int
  unitCostCents Int      @map("unit_cost_cents")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repair  PlaylandRepairLog @relation(fields: [repairId], references: [id], onDelete: Cascade)
  product PlaylandProduct   @relation(fields: [productId], references: [id])

  @@index([repairId])
  @@index([productId])
  @@map("repair_parts")
  @@schema("playland")
}

// ---------- 11. Sales (POS transactions) ----------
model PlaylandSale {
  id             String                @id @default(uuid()) @db.Uuid
  orgId          String                @map("org_id") @db.Uuid
  branchId       String                @map("branch_id") @db.Uuid
  shiftId        String?               @map("shift_id") @db.Uuid
  sessionId      String?               @map("session_id") @db.Uuid // null = walk-in sale
  saleCode       String                @unique @map("sale_code") // S-2569-NNNN
  totalCents     Int                   @map("total_cents")
  discountCents  Int                   @default(0) @map("discount_cents")
  promoId        String?               @map("promo_id") @db.Uuid
  paymentMethod  PlaylandPaymentMethod
  paymentRef     String?               @map("payment_ref")
  cashierUserId  String                @map("cashier_user_id") @db.Uuid
  soldAt         DateTime              @default(now()) @map("sold_at") @db.Timestamptz(6)
  voidedAt       DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidedByUserId String?               @map("voided_by_user_id") @db.Uuid
  voidReason     String?               @map("void_reason")

  branch  PlaylandBranch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift   PlaylandShift?     @relation(fields: [shiftId], references: [id])
  session PlaylandSession?   @relation(fields: [sessionId], references: [id])
  promo   PlaylandPromo?     @relation(fields: [promoId], references: [id])
  lines   PlaylandSaleLine[]

  @@index([orgId, branchId])
  @@index([branchId, soldAt])
  @@index([shiftId])
  @@index([sessionId])
  @@map("sales")
  @@schema("playland")
}

// ---------- 11b. Sale Line Items ----------
model PlaylandSaleLine {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") // snapshot
  quantity    Int
  unitCents   Int      @map("unit_cents")
  lineCents   Int      @map("line_cents")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale    PlaylandSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product PlaylandProduct @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_lines")
  @@schema("playland")
}

// ---------- 12. Promos ----------
model PlaylandPromo {
  id              String            @id @default(uuid()) @db.Uuid
  orgId           String            @map("org_id") @db.Uuid
  branchId        String?           @map("branch_id") @db.Uuid // null = all branches
  type            PlaylandPromoType
  code            String? // for COUPON
  name            String
  description     String?
  discountPercent Int?              @map("discount_percent") // 0-100
  discountCents   Int?              @map("discount_cents") // fixed amount
  conditions      Json? // {minSpend, daysOfWeek, packageIds, etc.}
  active          Boolean           @default(true)
  startsAt        DateTime?         @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime?         @map("ends_at") @db.Timestamptz(6)
  maxUses         Int?              @map("max_uses")
  usesCount       Int               @default(0) @map("uses_count")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch PlaylandBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales  PlaylandSale[]

  @@unique([code, orgId])
  @@index([orgId])
  @@index([type, active])
  @@map("promos")
  @@schema("playland")
}

// ---------- 13. Loyalty (per-member points wallet) ----------
model PlaylandLoyalty {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  memberId       String    @unique @map("member_id") @db.Uuid
  points         Int       @default(0)
  lifetimePoints Int       @default(0) @map("lifetime_points")
  lastEarnedAt   DateTime? @map("last_earned_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  member PlaylandMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  ledger PlaylandLoyaltyLedger[]

  @@map("loyalty")
  @@schema("playland")
}

model PlaylandLoyaltyLedger {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  loyaltyId String   @map("loyalty_id") @db.Uuid
  delta     Int // + earn, - redeem
  reason    String // "session", "birthday", "redeem", etc.
  refType   String?  @map("ref_type") // "session" | "sale" | "manual"
  refId     String?  @map("ref_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  loyalty PlaylandLoyalty @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)

  @@index([loyaltyId, createdAt])
  @@map("loyalty_ledger")
  @@schema("playland")
}

// ---------- 14. Waivers (ใบยินยอม) ----------
model PlaylandWaiver {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  memberId        String    @map("member_id") @db.Uuid
  version         String    @default("v1")
  signedAt        DateTime  @default(now()) @map("signed_at") @db.Timestamptz(6)
  signatureR2Path String?   @map("signature_r2_path") // PDF or PNG
  signatureType   String    @default("tablet") @map("signature_type") // "tablet" | "paper" | "checkbox"
  signedByName    String    @map("signed_by_name")
  signedByPhone   String?   @map("signed_by_phone")
  scannedR2Path   String?   @map("scanned_r2_path") // if paper, scan
  metadata        Json?
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  member PlaylandMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([memberId, signedAt])
  @@map("waivers")
  @@schema("playland")
}

// ---------- 15. Alerts ----------
model PlaylandAlert {
  id                   String                @id @default(uuid()) @db.Uuid
  orgId                String                @map("org_id") @db.Uuid
  branchId             String                @map("branch_id") @db.Uuid
  sessionId            String?               @map("session_id") @db.Uuid
  type                 PlaylandAlertType
  severity             PlaylandAlertSeverity @default(WARNING)
  title                String
  message              String?
  metadata             Json?
  resolvedAt           DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId     String?               @map("resolved_by_user_id") @db.Uuid
  acknowledgedAt       DateTime?             @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedByUserId String?               @map("acknowledged_by_user_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  branch  PlaylandBranch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  session PlaylandSession? @relation(fields: [sessionId], references: [id])

  @@index([orgId, branchId])
  @@index([branchId, resolvedAt])
  @@index([type, createdAt])
  @@map("alerts")
  @@schema("playland")
}

// ---------- 16. Shifts (per-cashier per-branch) ----------
model PlaylandShift {
  id                 String              @id @default(uuid()) @db.Uuid
  orgId              String              @map("org_id") @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  cashierUserId      String              @map("cashier_user_id") @db.Uuid
  shiftCode          String              @unique @map("shift_code") // SH-YYMMDD-NN
  startedAt          DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?           @map("ended_at") @db.Timestamptz(6)
  openingCashCents   Int                 @default(0) @map("opening_cash_cents")
  closingCashCents   Int?                @map("closing_cash_cents")
  expectedCashCents  Int?                @map("expected_cash_cents")
  varianceCents      Int?                @map("variance_cents") // closing - expected
  totalSalesCents    Int                 @default(0) @map("total_sales_cents")
  totalSessionsCents Int                 @default(0) @map("total_sessions_cents")
  status             PlaylandShiftStatus @default(OPEN)
  notes              String?
  closedByUserId     String?             @map("closed_by_user_id") @db.Uuid
  isDayClose         Boolean             @default(false) @map("is_day_close") // mark as day-end close

  branch PlaylandBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales  PlaylandSale[]

  @@index([orgId, branchId])
  @@index([branchId, startedAt])
  @@index([cashierUserId, startedAt])
  @@map("shifts")
  @@schema("playland")
}

// ---------- 17. Daily Reports (per-branch per-day rollup) ----------
model PlaylandDailyReport {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  reportDate          DateTime  @map("report_date") @db.Date
  entryRevenueCents   Int       @default(0) @map("entry_revenue_cents")
  productRevenueCents Int       @default(0) @map("product_revenue_cents")
  totalRevenueCents   Int       @default(0) @map("total_revenue_cents")
  memberCount         Int       @default(0) @map("member_count")
  sessionsCompleted   Int       @default(0) @map("sessions_completed")
  sessionsExpired     Int       @default(0) @map("sessions_expired")
  sessionsForfeited   Int       @default(0) @map("sessions_forfeited")
  productsSold        Int       @default(0) @map("products_sold")
  alertsCount         Int       @default(0) @map("alerts_count")
  breakdown           Json? // per-package, per-product, per-hour breakdown
  cashScannedIn       Int       @default(0) @map("cash_scanned_in") // anti-fraud: face scan count
  cashScannedOut      Int       @default(0) @map("cash_scanned_out")
  fraudVariance       Int       @default(0) @map("fraud_variance") // scan in/out vs paid count
  submittedAt         DateTime? @map("submitted_at") @db.Timestamptz(6)
