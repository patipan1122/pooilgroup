# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง

# URL เว็บจริง (ห้ามมี / ปิดท้าย)
CLOUD_BASE_URL=https://pooilgroup.vercel.app

# รายชื่อเครื่อง คั่นด้วย , แต่ละเครื่องคั่นด้วย : ตามลำดับ (ค่าด้านล่างเป็นตัวอย่าง — ห้ามใช้ secret จริง)
#   <รหัสเครื่อง (deviceId ใน DB)>:<IP บนวง LAN>:<รหัสผ่านเครื่อง>:<webhookSecret ของเครื่องนี้>
DEVICES=DEVICE-A-ID:192.168.1.10:123456:REPLACE_WITH_REAL_SECRET_A,DEVICE-B-ID:192.168.1.11:123456:REPLACE_WITH_REAL_SECRET_B

# พอร์ตที่ agent เปิดรับ log จากเครื่อง (ต้องตรงกับที่ router/firewall อนุญาต)
AGENT_PORT=8080

# IP ของคอมเครื่องนี้บนวง LAN เดียวกับเครื่องสแกน (ถ้าไม่ใส่ agent จะเดาให้อัตโนมัติ)
# AGENT_IP=192.168.1.50

# ความถี่ถามคิว "ต้องเพิ่ม/ลบหน้าใครไหม" (มิลลิวินาที)
POLL_INTERVAL_MS=5000

# เครื่องพิมพ์สายรัด NIIMBOT K2 (ต่อ USB กับเครื่องนี้) — ไม่ใส่ = ไม่เปิดคิวพิมพ์
#   <รหัสเครื่อง>:<รหัสลับ>  ต้องตรงกับแถวในตาราง playland.printers (ใน DB เก็บเป็น hash)
# PRINTERS=K2-TEST-01:REPLACE_WITH_PRINTER_SECRET
# พอร์ต USB ของ K2 ถ้าไม่ใส่ agent จะหาเอง (macOS: /dev/cu.usbmodemK2_...)
# K2_SERIAL_PATH=/dev/cu.usbmodemK2_XXXX
# PRINT_POLL_INTERVAL_MS=3000
